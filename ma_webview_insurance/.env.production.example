# =============================================================================
# Insurance Mini App - Production Profile Template (.env.production.example)
# =============================================================================

PORT=3004
NEXT_PUBLIC_ENVIRONMENT=PROD
NEXT_PUBLIC_SUPERAPP_ORIGIN=https://superapp.gov.kh
NEXT_PUBLIC_API_URL=https://api.superapp.gov.kh
MINIAPP_VERIFICATION_TOKEN=CHANGE_ME_PRODUCTION_VERIFICATION_TOKEN

# Reverse Proxy & Backend Integration
BACKEND_API_URL=https://api.superapp.gov.kh/api/v1
BACKEND_INTERNAL_SECRET=CHANGE_ME_PRODUCTION_INTERNAL_SECRET

# Super App JWKS Endpoint for SSO Token Validation
SUPERAPP_AUTH_JWKS_URL=https://api.superapp.gov.kh/auth/jwks
DPS_AUTH_JWKS_URL=https://api.superapp.gov.kh/auth/jwks
