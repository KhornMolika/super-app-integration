pipeline {
    agent any

    parameters {
        string(name: 'MINIAPP_ID', defaultValue: '', description: 'Mini App UUID')
        string(name: 'TARGET_URL', defaultValue: '', description: 'Target WebView Endpoint URL')
        string(name: 'ALLOWED_DOMAINS', defaultValue: '', description: 'Comma-separated allowlist of navigation domains')
        string(name: 'CALLBACK_URL', defaultValue: 'http://host.docker.internal:3000/api/integrations/validation/callback', description: 'NestJS Backend Webhook URL')
        booleanParam(name: 'ALLOW_LOCAL', defaultValue: false, description: 'Permit localhost/private IP for local dev testing')
    }

    environment {
        REPORT_DIR = "/var/reports"
        REPORT_FILE = "/var/reports/validation-${params.MINIAPP_ID}.json"
        SSRF_REPORT = "/var/reports/ssrf-${params.MINIAPP_ID}.json"
        ZAP_REPORT = "/var/reports/zap-${params.MINIAPP_ID}.json"
        TLS_REPORT = "/var/reports/testssl-${params.MINIAPP_ID}.json"
        NUCLEI_REPORT = "/var/reports/nuclei-${params.MINIAPP_ID}.json"
    }

    stages {
        stage('1. Pre-Flight & SSRF Defense') {
            steps {
                echo "=========================================================="
                echo " Starting Automated WebView Validation"
                echo " Mini App ID   : ${params.MINIAPP_ID}"
                echo " Target URL    : ${params.TARGET_URL}"
                echo " Allowed Scope : ${params.ALLOWED_DOMAINS}"
                echo " Allow Local   : ${params.ALLOW_LOCAL}"
                echo "=========================================================="
                
                sh 'mkdir -p ${REPORT_DIR} && chmod -R 777 ${REPORT_DIR}'

                script {
                    // Real-time Stage Notification: RUNNING
                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "ssrf",
                                stageName: "1. Pre-Flight & SSRF Defense",
                                status: "RUNNING",
                                details: "Resolving target DNS & verifying IP routing scope..."
                            })
                        }).catch(() => {});
                    ' || true
                    """

                    sh """
                    node -e '
                        const fs = require("fs");
                        const net = require("net");
                        const dns = require("dns").promises;

                        const rawUrl = (process.argv[1] || "").trim();
                        const allowLocal = process.argv[2] === "true";
                        const miniAppId = process.argv[3];
                        const ssrfOut = "${env.SSRF_REPORT}";

                        function isPrivateIp(ip) {
                            if (ip.startsWith("127.") || ip === "0.0.0.0" || ip === "::1") return true;
                            if (ip.startsWith("10.") || ip.startsWith("192.168.")) return true;
                            if (ip.startsWith("169.254.")) return true;
                            if (ip.startsWith("172.")) {
                                const p = ip.split(".").map(Number);
                                if (p[1] >= 16 && p[1] <= 31) return true;
                            }
                            return false;
                        }

                        async function check() {
                            let url;
                            try {
                                url = new URL(rawUrl);
                            } catch (err) {
                                fs.writeFileSync(ssrfOut, JSON.stringify({ passed: false, error: "Malformed URL format: " + rawUrl }));
                                return;
                            }

                            const hostname = url.hostname;
                            let ips = [];

                            if (net.isIP(hostname)) {
                                ips = [hostname];
                            } else if (hostname === "localhost") {
                                ips = ["127.0.0.1"];
                            } else {
                                try {
                                    ips = await dns.resolve4(hostname);
                                } catch (e) {
                                    if (allowLocal) {
                                        ips = ["127.0.0.1"];
                                    } else {
                                        fs.writeFileSync(ssrfOut, JSON.stringify({ passed: false, error: "DNS lookup failed for hostname: " + hostname }));
                                        return;
                                    }
                                }
                            }

                            console.log("Resolved target IPs:", ips);
                            let passed = true;
                            let failureReason = null;

                            for (const ip of ips) {
                                if (isPrivateIp(ip) && !allowLocal) {
                                    passed = false;
                                    failureReason = "Target resolves to private/restricted IP address: " + ip;
                                    break;
                                }
                            }

                            fs.writeFileSync(ssrfOut, JSON.stringify({
                                passed: passed,
                                ips: ips,
                                error: failureReason
                            }));
                            console.log("SSRF Stage finished: passed =", passed);
                        }

                        check();
                    ' "${params.TARGET_URL}" "${params.ALLOW_LOCAL}" "${params.MINIAPP_ID}"
                    """

                    // Real-time Stage Notification: COMPLETED
                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "ssrf",
                                stageName: "1. Pre-Flight & SSRF Defense",
                                status: "COMPLETED",
                                details: "DNS resolution & IP routing verified."
                            })
                        }).catch(() => {});
                    ' || true
                    """
                }
            }
        }

        stage('2. TLS & HTTPS Security') {
            steps {
                script {
                    echo "Evaluating TLS 1.2+ Security..."
                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "tls",
                                stageName: "2. TLS & HTTPS Security",
                                status: "RUNNING",
                                details: "Auditing cipher suites & certificate validity..."
                            })
                        }).catch(() => {});
                    ' || true
                    """

                    sh """
                        if echo "${params.TARGET_URL}" | grep -q "^https://"; then
                            docker run --rm -u root -v /var/reports:/reports:rw drwetter/testssl.sh \
                                --quiet \
                                --color 0 \
                                --jsonfile-pretty /reports/testssl-${params.MINIAPP_ID}.json \
                                "${params.TARGET_URL}" || true
                        else
                            echo "Notice: Target is plain HTTP. Skipping testssl cipher analysis."
                        fi
                    """

                    sh """
                    node -e '
                        const isHttps = "${params.TARGET_URL}".startsWith("https://");
                        const allowLocal = "${params.ALLOW_LOCAL}" === "true";
                        const passed = isHttps || allowLocal;
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "tls",
                                stageName: "2. TLS & HTTPS Security",
                                status: passed ? "COMPLETED" : "FAILED",
                                details: isHttps
                                    ? "TLS 1.2+ transport security verified."
                                    : (allowLocal ? "Plain HTTP permitted in development mode (ALLOW_LOCAL=true)." : "Target uses insecure plain HTTP.")
                            })
                        }).catch(() => {});
                    ' || true
                    """
                }
            }
        }

        stage('3. DAST, XSS & CSP Audit (OWASP ZAP)') {
            steps {
                echo "Running OWASP ZAP Baseline DAST & CSP Audit..."
                script {
                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "zap",
                                stageName: "3. OWASP ZAP DAST Scan",
                                status: "RUNNING",
                                details: "Running spider, active XSS & CSP header audit..."
                            })
                        }).catch(() => {});
                    ' || true
                    """

                    sh """
                        chmod -R 777 /var/reports
                        docker run --rm -u root -v /var/reports:/zap/wrk:rw zaproxy/zap-stable zap-baseline.py \
                            -t "${params.TARGET_URL}" \
                            -J "zap-${params.MINIAPP_ID}.json" \
                            -r "zap-${params.MINIAPP_ID}.html" \
                            -I || true
                    """

                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "zap",
                                stageName: "3. OWASP ZAP DAST Scan",
                                status: "COMPLETED",
                                details: "OWASP ZAP baseline scan complete."
                            })
                        }).catch(() => {});
                    ' || true
                    """
                }
            }
        }

        stage('4. Exposure & Vulnerability Audit (Nuclei)') {
            steps {
                echo "Running Nuclei Scanner for Exposed .env, .git, and CVEs..."
                script {
                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "nuclei",
                                stageName: "4. Exposure & Vulnerability Audit",
                                status: "RUNNING",
                                details: "Scanning for exposed secrets, .git folders & known CVEs..."
                            })
                        }).catch(() => {});
                    ' || true
                    """

                    sh """
                        chmod -R 777 /var/reports
                        docker run --rm -u root -v /var/reports:/reports:rw projectdiscovery/nuclei:latest \
                            -u "${params.TARGET_URL}" \
                            -tags cve,exposure,misconfig \
                            -severity critical,high \
                            -json-export /reports/nuclei-${params.MINIAPP_ID}.json \
                            -silent || true
                    """

                    sh """
                    node -e '
                        const callbackUrl = "${params.CALLBACK_URL}".replace("/callback", "/stage");
                        fetch(callbackUrl, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                miniAppId: "${params.MINIAPP_ID}",
                                stageId: "nuclei",
                                stageName: "4. Exposure & Vulnerability Audit",
                                status: "COMPLETED",
                                details: "Nuclei vulnerability audit complete."
                            })
                        }).catch(() => {});
                    ' || true
                    """
                }
            }
        }

        stage('5. Synthesize Findings & Webhook Callback') {
            steps {
                script {
                    echo "Aggregating security scan results and dispatching callback..."
                    sh """
                    node -e '
                        const fs = require("fs");

                        const miniAppId = "${params.MINIAPP_ID}";
                        const targetUrl = "${params.TARGET_URL}";
                        const allowLocal = "${params.ALLOW_LOCAL}" === "true";
                        const ssrfFile = "${env.SSRF_REPORT}";
                        const zapFile = "${env.ZAP_REPORT}";
                        const tlsFile = "${env.TLS_REPORT}";
                        const nucleiFile = "${env.NUCLEI_REPORT}";
                        const callbackUrl = "${params.CALLBACK_URL}";

                        const findings = [];
                        let score = 100;
                        const checks = {
                            ssrf: { passed: true, details: "Target resolves to permitted IP." },
                            tls: { passed: true, details: "HTTPS configured." },
                            dast: { passed: true, details: "No high severity XSS found." },
                            exposure: { passed: true, details: "No exposed secrets or .env detected." }
                        };

                        // 1. SSRF Check
                        if (fs.existsSync(ssrfFile)) {
                            try {
                                const ssrf = JSON.parse(fs.readFileSync(ssrfFile, "utf8"));
                                if (!ssrf.passed) {
                                    checks.ssrf.passed = false;
                                    checks.ssrf.details = ssrf.error || "SSRF check failed";
                                    findings.push({
                                        id: "SSRF_RESTRICTED_IP",
                                        severity: "CRITICAL",
                                        category: "NETWORK_SECURITY",
                                        title: "SSRF Protection: Private IP Prohibited",
                                        description: ssrf.error || "Target URL points to an internal private IP address.",
                                        recommendation: "Deploy on a public domain or enable developer mode."
                                    });
                                    score -= 50;
                                }
                            } catch (e) {}
                        }

                        // 2. TLS Check
                        if (targetUrl.startsWith("http://")) {
                            if (allowLocal) {
                                checks.tls.passed = true;
                                checks.tls.details = "Plain HTTP permitted in development mode (ALLOW_LOCAL=true).";
                                console.log("Development mode: HTTP permitted without penalty.");
                            } else {
                                checks.tls.passed = false;
                                checks.tls.details = "Production URL uses unencrypted HTTP";
                                findings.push({
                                    id: "INSECURE_TRANSPORT",
                                    severity: "HIGH",
                                    category: "TRANSPORT_SECURITY",
                                    title: "Insecure HTTP Protocol",
                                    description: "The Mini App endpoint uses plain HTTP instead of encrypted HTTPS.",
                                    recommendation: "Enforce TLS 1.2+ with a valid SSL certificate."
                                });
                                score -= 25;
                            }
                        }

                        // 3. Nuclei Check
                        if (fs.existsSync(nucleiFile)) {
                            try {
                                const lines = fs.readFileSync(nucleiFile, "utf8").trim().split(String.fromCharCode(10)).filter(Boolean);
                                for (const line of lines) {
                                    const item = JSON.parse(line);
                                    findings.push({
                                        id: item.template_id || "NUCLEI_EXPOSURE",
                                        severity: (item.info?.severity || "HIGH").toUpperCase(),
                                        category: "VULNERABILITY",
                                        title: item.info?.name || "Security Exposure Detected",
                                        description: item.matched_at ? "Matched on endpoint: " + item.matched_at : "Vulnerability detected",
                                        recommendation: "Remove exposed files and update vulnerable dependencies."
                                    });
                                    checks.exposure.passed = false;
                                    score -= 25;
                                }
                            } catch (e) {}
                        }

                        // 4. ZAP Check
                        if (fs.existsSync(zapFile)) {
                            try {
                                const zap = JSON.parse(fs.readFileSync(zapFile, "utf8"));
                                const site = zap.site?.[0] || {};
                                const alerts = site.alerts || [];
                                for (const alert of alerts) {
                                    const risk = (alert.riskdesc || "").split(" ")[0].toUpperCase();
                                    if (risk === "HIGH" || risk === "CRITICAL") {
                                        findings.push({
                                            id: "ZAP_" + alert.pluginId,
                                            severity: "HIGH",
                                            category: "DAST",
                                            title: alert.alert || alert.name,
                                            description: alert.desc ? alert.desc.substring(0, 300) : "DAST Security Alert",
                                            recommendation: alert.solution ? alert.solution.substring(0, 300) : "Apply recommended security headers."
                                        });
                                        checks.dast.passed = false;
                                        score -= 30;
                                    }
                                }
                            } catch (e) {}
                        }

                        const hasCriticalOrHigh = findings.some(f => f.severity === "CRITICAL" || f.severity === "HIGH");
                        const status = hasCriticalOrHigh ? "FAILED" : "PASSED";

                        const payload = {
                            miniAppId: miniAppId,
                            method: "WEBVIEW",
                            status: status,
                            score: Math.max(0, score),
                            checks: checks,
                            findings: findings,
                            reportPath: "${env.REPORT_FILE}"
                        };

                        fs.writeFileSync("${env.REPORT_FILE}", JSON.stringify(payload, null, 2));
                        console.log("Final Validation Status:", status, "Score:", payload.score, "Findings Count:", findings.length);
                    '
                    """

                    sh "curl -s -X POST -H 'Content-Type: application/json' -d @'${env.REPORT_FILE}' '${params.CALLBACK_URL}'"
                }
            }
        }
    }

    post {
        failure {
            script {
                echo "Pipeline failed unexpectedly. Dispatching FAILED status to backend..."
                sh """
                STAGE_URL="\$(echo '${params.CALLBACK_URL}' | sed 's|/callback|/stage|')"
                curl -s -X POST -H 'Content-Type: application/json' \
                  -d '{"miniAppId":"${params.MINIAPP_ID}","stageId":"ssrf","stageName":"Validation Pipeline","status":"FAILED","details":"Pipeline execution failed or scanner encountered an error."}' \
                  "\${STAGE_URL}" || true

                curl -s -X POST -H 'Content-Type: application/json' \
                  -d '{"miniAppId":"${params.MINIAPP_ID}","method":"WEBVIEW","status":"FAILED","score":0,"checks":{"pipeline":{"passed":false,"details":"Jenkins validation pipeline failed unexpectedly."}},"findings":[{"id":"PIPELINE_ERROR","severity":"CRITICAL","category":"SYSTEM_CHECK","title":"Security Validation Pipeline Failed","description":"The automated Jenkins validation pipeline was interrupted or encountered an execution error.","recommendation":"Review target server accessibility or inspect Jenkins build logs at http://localhost:8085/job/webview-validation/"}]}' \
                  "${params.CALLBACK_URL}" || true
                """
            }
        }
        aborted {
            script {
                echo "Pipeline was aborted. Dispatching FAILED status to backend..."
                sh """
                curl -s -X POST -H 'Content-Type: application/json' \
                  -d '{"miniAppId":"${params.MINIAPP_ID}","method":"WEBVIEW","status":"FAILED","score":0,"checks":{"pipeline":{"passed":false,"details":"Pipeline was aborted."}},"findings":[{"id":"PIPELINE_ABORTED","severity":"HIGH","category":"SYSTEM_CHECK","title":"Security Validation Aborted","description":"The Jenkins validation pipeline was stopped before completion.","recommendation":"Re-run the automated security scan."}]}' \
                  "${params.CALLBACK_URL}" || true
                """
            }
        }
        always {
            archiveArtifacts artifacts: 'reports/*', allowEmptyArchive: true
            echo "Security validation run complete for Mini App: ${params.MINIAPP_ID}"
        }
    }
}
