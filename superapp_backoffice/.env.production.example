# =============================================================================
# Super App Backoffice - Production Profile Template (.env.production.example)
# =============================================================================

# Server & Runtime Environment
PORT=3002
NODE_ENV=production
NEXT_PUBLIC_ENVIRONMENT=PROD
NEXT_PUBLIC_APP_URL=https://app.fintechcenterfsa.com
NEXT_PUBLIC_BACKOFFICE_URL=https://app.fintechcenterfsa.com

# Backend API & Authentication
BACKEND_API_URL=https://app.fintechcenterfsa.com/api
NEXT_PUBLIC_API_URL=https://app.fintechcenterfsa.com/api
BACKEND_INTERNAL_SECRET=CHANGE_ME_PRODUCTION_INTERNAL_SECRET
NEXT_PUBLIC_SOCKET_URL=https://app.fintechcenterfsa.com/api

# Artifact Repositories & Storage Endpoints
NEXT_PUBLIC_NEXUS_URL=https://app.fintechcenterfsa.com/nexus
NEXT_PUBLIC_NEXUS_PUB_GROUP_URL=https://app.fintechcenterfsa.com/nexus/repository/pub-group
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXUS_BASE_URL=https://app.fintechcenterfsa.com/nexus
NEXUS_INTERNAL_URL=https://app.fintechcenterfsa.com/nexus
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_NEXUS_PASSWORD

# CI / CD Jenkins Controller & Super App Git
NEXT_PUBLIC_JENKINS_URL=https://app.fintechcenterfsa.com/jenkins
NEXT_PUBLIC_SUPERAPP_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git
NEXT_PUBLIC_SUPERAPP_SANDBOX_URL=/superapp-sandbox/index.html

# Super App Sandbox Preview Security Policies
NEXT_PUBLIC_PREVIEW_ENABLED=true
NEXT_PUBLIC_PREVIEW_ALLOW_LOCALHOST=false
NEXT_PUBLIC_PREVIEW_REQUIRE_HTTPS=true
NEXT_PUBLIC_PREVIEW_SESSION_TIMEOUT=900

# Default Credentials & Seed Administrative Accounts
NEXT_PUBLIC_DEFAULT_USER=admin
NEXT_PUBLIC_DEFAULT_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
DEV_FALLBACK_USER_EMAIL=superadmin@superapp.gov.kh
DEV_FALLBACK_USER_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
NEXT_PUBLIC_SUPERADMIN_EMAIL=superadmin@superapp.gov.kh
NEXT_PUBLIC_ADMIN_EMAIL=admin@superapp.gov.kh
NEXT_PUBLIC_MANAGER_EMAIL=manager@superapp.gov.kh
NEXT_PUBLIC_DEV_EMAIL=dev@superapp.gov.kh
