# =============================================================================
# Super App Backoffice - Environment Template (.env.example)
# =============================================================================

# Server & Runtime Environment
PORT=3002
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=DEV

# Backend API & Authentication
BACKEND_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000
BACKEND_INTERNAL_SECRET=your_backend_internal_secret
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Artifact Repositories & Storage Endpoints
NEXT_PUBLIC_NEXUS_URL=http://localhost:8081
NEXT_PUBLIC_NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXUS_BASE_URL=http://localhost:8081
NEXUS_INTERNAL_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=your_secure_nexus_password

# CI / CD Jenkins Controller & Super App Git
NEXT_PUBLIC_JENKINS_URL=http://localhost:8085
NEXT_PUBLIC_SUPERAPP_GIT_REPO_URL=https://github.com/KhornMolika/super-app-integration.git
NEXT_PUBLIC_SUPERAPP_SANDBOX_URL=/superapp-sandbox/index.html

# Super App Sandbox Preview Security Policies
NEXT_PUBLIC_PREVIEW_ENABLED=true
NEXT_PUBLIC_PREVIEW_ALLOW_LOCALHOST=true
NEXT_PUBLIC_PREVIEW_REQUIRE_HTTPS=false
NEXT_PUBLIC_PREVIEW_SESSION_TIMEOUT=3600

# Default Credentials & Seed Administrative Accounts
NEXT_PUBLIC_DEFAULT_USER=admin
NEXT_PUBLIC_DEFAULT_PASSWORD=your_secure_admin_password
DEV_FALLBACK_USER_EMAIL=superadmin@example.com
DEV_FALLBACK_USER_PASSWORD=your_secure_admin_password
NEXT_PUBLIC_SUPERADMIN_EMAIL=superadmin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_MANAGER_EMAIL=manager@example.com
NEXT_PUBLIC_DEV_EMAIL=dev@example.com
