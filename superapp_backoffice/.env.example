# ==========================================
# Super App Backoffice Portal - Environment Configuration
# ==========================================

# Backend API Configuration
BACKEND_API_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Registry & Storage Endpoints
NEXT_PUBLIC_NEXUS_URL=http://localhost:8081
NEXT_PUBLIC_NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
NEXT_PUBLIC_MINIO_URL=http://localhost:9000
NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=

# CI / CD Jenkins Controller
NEXT_PUBLIC_JENKINS_URL=http://localhost:8085

# Official Super App Mobile Repository URL
NEXT_PUBLIC_SUPERAPP_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git

# Development Authentication Fallbacks
DEV_FALLBACK_USER_EMAIL=superadmin@example.com
DEV_FALLBACK_USER_PASSWORD=
NEXT_PUBLIC_SUPERADMIN_EMAIL=superadmin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_MANAGER_EMAIL=manager@example.com
NEXT_PUBLIC_DEV_EMAIL=dev@example.com

# Runtime Environment (local, development, production)
NEXT_PUBLIC_ENVIRONMENT=local
