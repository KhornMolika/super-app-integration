PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dps_user
DB_PASSWORD=dps_password
DB_DATABASE=dps_db
DB_SYNC=true
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1d

# Environment mode: DEV | PROD
# In DEV mode: HTTP and local/private IPs are permitted for testing
# In PROD mode: Strict HTTPS and SSRF restrictions are enforced
ENVIRONMENT=DEV

# Git & Package Integration Settings
GIT_PROVIDER=github
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=

NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=admin123
NEXUS_PUB_HOSTED_URL=http://localhost:8081/repository/pub-hosted
NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
