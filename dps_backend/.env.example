# -----------------------------------------------------------------------------
# DPS Backend Environment Configuration Template (.env.example)
# -----------------------------------------------------------------------------

# Server Configuration
PORT=3000
NODE_ENV=development

# Environment Mode: DEV | PROD
# In DEV mode: HTTP and local/private IP addresses are permitted for testing
# In PROD mode: Strict HTTPS, SSRF protections, and secure headers are enforced
ENVIRONMENT=DEV

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dps_user
DB_PASSWORD=dps_password
DB_DATABASE=dps_db
DB_SYNC=true

# JWT Authentication
JWT_SECRET=replace-with-secure-random-secret
JWT_EXPIRES_IN=1d

# Email Notification Service (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Jenkins CI/CD Controller
JENKINS_URL=http://localhost:8085
JENKINS_USER=admin
JENKINS_API_TOKEN=your-jenkins-api-token
CALLBACK_BASE_URL=http://host.docker.internal:3000

# Sonatype Nexus Artifact Repository
NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=your-nexus-admin-password
NEXUS_PUB_HOSTED_URL=http://localhost:8081/repository/pub-hosted
NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group

# S3 / MinIO Object Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your-minio-admin-password
MINIO_SUBNET_LICENSE=

# Git Integration Settings
GIT_PROVIDER=github
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=
