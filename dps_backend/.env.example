PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=dps_user
DB_PASSWORD=dps_password
DB_DATABASE=dps_db
DB_SYNC=true
JWT_SECRET=your-secret-jwt-key
JWT_EXPIRES_IN=1d

ALLOW_LOCAL_PROD_URLS=true

# Git Provider Configuration (github | gitlab)
GIT_PROVIDER=github

# GitHub Provider Settings
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=your_github_personal_access_token

# GitLab Provider Settings (Organization / Production)
GITLAB_BASE_URL=https://gitlab.company.com
GITLAB_TOKEN=your_gitlab_personal_access_token

# Sonatype Nexus Registry Settings
NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=admin123
NEXUS_PUB_HOSTED_URL=http://localhost:8081/repository/pub-hosted
NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
