# -----------------------------------------------------------------------------
# DPS Backend Production Profile Template (.env.production.example)
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
ENVIRONMENT=PROD

DB_HOST=postgres.production.internal
DB_PORT=5432
DB_USERNAME=dps_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD
DB_DATABASE=dps_production_db
DB_SYNC=false

JWT_SECRET=CHANGE_ME_SECURE_256_BIT_RANDOM_KEY
JWT_EXPIRES_IN=1d

RESEND_API_KEY=re_prod_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=notifications@superapp.gov.kh

JENKINS_URL=https://jenkins.ci.internal
JENKINS_USER=jenkins-service-account
JENKINS_API_TOKEN=CHANGE_ME_PRODUCTION_JENKINS_TOKEN
CALLBACK_BASE_URL=https://api.superapp.gov.kh

NEXUS_BASE_URL=https://nexus.artifacts.internal
NEXUS_ADMIN_USER=nexus-deployer
NEXUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_NEXUS_PASSWORD
NEXUS_PUB_HOSTED_URL=https://nexus.artifacts.internal/repository/pub-hosted
NEXUS_PUB_GROUP_URL=https://nexus.artifacts.internal/repository/pub-group

MINIO_ENDPOINT=s3.production.internal
MINIO_PORT=443
MINIO_ROOT_USER=s3-superapp-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_S3_SECRET_KEY
MINIO_SUBNET_LICENSE=

GIT_PROVIDER=github
GITHUB_BASE_URL=https://api.github.com
GITHUB_TOKEN=
