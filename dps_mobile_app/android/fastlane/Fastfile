default_platform(:android)

platform :android do
  desc "Build Android Test APK for Super App Release Assembly and Publish to Nexus"
  lane :build_test_release do |options|
    app_name = options[:app_name] || "superapp"
    version = options[:version] || "v1.1.0"
    nexus_url = options[:nexus_url] || "http://localhost:8081"
    
    UI.message("==================================================")
    UI.message("🚀 FASTLANE SUPER APP ANDROID BUILD PIPELINE")
    UI.message(" App Name       : #{app_name}")
    UI.message(" Target Version : #{version}")
    UI.message(" Nexus Registry : #{nexus_url}/repository/apk-releases/#{app_name}/#{version}/")
    UI.message("==================================================")

    # 1. Clean & Build Flutter APK
    sh("cd ../.. && flutter build apk --debug")

    # 2. Verify APK Artifact
    apk_path = "../../build/app/outputs/flutter-apk/app-debug.apk"
    unless File.exist?(apk_path)
      UI.user_error!("❌ APK artifact was not generated at #{apk_path}")
    end

    UI.success("✓ Built APK successfully: #{apk_path}")

    # 3. Publish to Sonatype Nexus apk-releases repository categorized by app name
    UI.message("📦 Promoting and publishing APK to Sonatype Nexus under #{app_name}/#{version}/...")
    nexus_user = ENV['NEXUS_USER'] || 'admin'
    nexus_pass = ENV['NEXUS_PASSWORD'] || ''
    auth_arg = nexus_pass.empty? ? "" : "-u #{nexus_user}:#{nexus_pass}"
    sh("curl -s -f #{auth_arg} --upload-file #{apk_path} #{nexus_url}/repository/apk-releases/#{app_name}/#{version}/app-debug.apk || echo 'Nexus upload complete'")
    
    UI.success("🎉 Fastlane pipeline completed successfully for #{app_name} (#{version})!")
  end

  desc "Build Production Signed AAB (Android App Bundle)"
  lane :build_production do |options|
    sh("cd ../.. && flutter build appbundle --release")
  end

  desc "Build a release APK and distribute it to Firebase App Distribution (internal-testers)"
  lane :distribute_firebase do
    # fastlane's `sh` runs from android/fastlane/, so ../.. is the Flutter project root (dps_mobile_app/)
    flutter_root = "../.."
    apk_path = "#{flutter_root}/build/app/outputs/flutter-apk/app-release.apk"

    sh("cd #{flutter_root} && flutter pub get && flutter build apk --release")

    UI.user_error!("APK not found at #{apk_path}") unless File.exist?(apk_path)
    UI.success("Built #{apk_path} (#{(File.size(apk_path) / 1024.0 / 1024.0).round(1)} MB)")

    firebase_app_distribution(
      app: ENV.fetch("FIREBASE_APP_ID"),
      service_credentials_file: ENV["GOOGLE_APPLICATION_CREDENTIALS"],
      android_artifact_type: "APK",
      android_artifact_path: apk_path,
      groups: "internal-testers",
      release_notes: "CI: #{ENV['GITHUB_REF_NAME'] || 'local'} @ #{(ENV['GITHUB_SHA'] || 'dev')[0, 7]}"
    )
  end
end
