# -----------------------------------------------------------------------------
# Banking Mini App Environment Template (.env.example)
# -----------------------------------------------------------------------------
PORT=3003
NEXT_PUBLIC_ENVIRONMENT=DEV
NEXT_PUBLIC_SUPERAPP_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3000
MINIAPP_VERIFICATION_TOKEN=dev-miniapp-verification-token

# Reverse Proxy & Backend Integration
BACKEND_API_URL=http://localhost:3000/api/v1
BACKEND_INTERNAL_SECRET=dev-secret-jwt-key-for-local-testing

# DPS Super App JWKS Endpoint for SSO Token Validation
DPS_AUTH_JWKS_URL=http://localhost:3000/auth/jwks
