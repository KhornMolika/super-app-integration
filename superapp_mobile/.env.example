# =============================================================================
# Super App Mobile (Flutter) - Build Time Configuration Reference (.env.example)
# =============================================================================
# Flutter does not load runtime .env files on native mobile targets by default.
# Instead, build-time variables are passed using `--dart-define` flags.
#
# Examples:
#   flutter run --dart-define=API_URL=http://localhost:3000 --dart-define=DEFAULT_LOGIN_EMAIL=admin@example.com
#   flutter build web --dart-define=API_URL=http://localhost:3000
#   flutter build apk --dart-define=API_URL=https://api.superapp.gov.kh
# =============================================================================

# Backend API Endpoint Base URL (used in lib/app/config/api_config.dart)
API_URL=http://localhost:3000

# Pre-filled default login email (used in lib/app/modules/login/controllers/login_controller.dart)
DEFAULT_LOGIN_EMAIL=admin@example.com
