// Super App Flutter Web sandbox (the Backoffice preview at /superapp-sandbox/):
// compiles inside Jenkins with the Flutter Docker image, then copies build/web to
// SANDBOX_OUTPUT_DIR and, optionally, uploads an archive to Nexus.
//
// It sends no build callback: /release-assembly/build-callback moves every BUILDING
// mini app to TESTING, which a sandbox rebuild must never do.
def p(String name) {
    // Parameters added after the job was created are null on the first run with this file
    def defaults = [
        REPO_URL: 'https://git.fintechcenterfsa.com/frontend/super-app.git',
        BRANCH: 'development',
        GIT_CREDENTIALS_ID: 'git-action',
        BASE_HREF: '/superapp-sandbox/',
        BUILD_MODE: 'release',
        FLUTTER_IMAGE: 'ghcr.io/cirruslabs/flutter:3.44.0',
        DEPLOY_SANDBOX: true,
        PUBLISH_TO_NEXUS: false,
        NEXUS_URL: 'https://app.fintechcenterfsa.com/nexus',
        NEXUS_USER: 'admin',
        PRIVATE_GIT_DEPS: 'https://github.com/KhornMolika/sc-private-miniapp.git=github-sc-private-miniapp',
        PUB_GATEWAY_URL: 'https://app.fintechcenterfsa.com/pub',
    ]
    def v = params[name]
    return (v == null || v == '') ? defaults[name] : v
}

/** Private Git dependencies of the Super App: "<https url>=<Jenkins SSH credential id>", comma separated. */
def privateGitDeps() {
    def deps = []
    for (entry in (p('PRIVATE_GIT_DEPS') ?: '').split(',')) {
        def e = entry.trim()
        if (!e) continue
        def parts = e.split('=', 2)
        if (parts.length != 2 || !(parts[0] ==~ /https:\/\/github\.com\/[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+\.git/) || !(parts[1] ==~ /[A-Za-z0-9._-]+/)) {
            error("Invalid PRIVATE_GIT_DEPS entry: ${e}")
        }
        deps << [url: parts[0], cred: parts[1]]
    }
    return deps
}

/**
 * Runs body with each private Git dependency fetched over SSH with its own
 * read-only deploy key (see Jenkinsfile.superapp-test-build).
 */
def withPrivateGitDeps(Closure body) {
    def deps = privateGitDeps()
    if (!deps) { body(); return }
    def bindings = []
    def list = []
    for (int i = 0; i < deps.size(); i++) {
        bindings << sshUserPrivateKey(credentialsId: deps[i].cred, keyFileVariable: "GIT_DEP_KEY_${i}")
        list << "${i}|${deps[i].url}"
    }
    withCredentials(bindings) {
        withEnv(["GIT_DEP_LIST=${list.join('\n')}"]) {
            sh '''
                set -e
                S="$WORKSPACE/.ci-secrets"; rm -rf "$S"; mkdir -p "$S"; chmod 700 "$S"
                : > "$S/ssh_config"; : > "$S/gitconfig"
                printf '%s\\n' "$GIT_DEP_LIST" | while IFS='|' read -r i url; do
                    [ -n "$url" ] || continue
                    cp "$(printenv "GIT_DEP_KEY_$i")" "$S/key_$i"; chmod 600 "$S/key_$i"
                    printf 'Host gh-dep-%s\\n  HostName github.com\\n  User git\\n  IdentityFile %s\\n  IdentitiesOnly yes\\n  StrictHostKeyChecking accept-new\\n  UserKnownHostsFile %s/known_hosts\\n' "$i" "$S/key_$i" "$S" >> "$S/ssh_config"
                    printf '[url "gh-dep-%s:%s"]\\n\\tinsteadOf = %s\\n' "$i" "${url#https://github.com/}" "$url" >> "$S/gitconfig"
                done
                echo "Private Git dependencies: $(grep -c insteadOf "$S/gitconfig")"
            '''
        }
    }
    try { body() } finally { sh 'rm -rf "$WORKSPACE/.ci-secrets"' }
}

def validateParams() {
    if (!(p('BRANCH') ==~ /[A-Za-z0-9._\/-]{1,100}/)) { error("Invalid BRANCH") }
    if (!(p('REPO_URL') ==~ /https:\/\/[A-Za-z0-9._:\/-]+\.git/)) { error("Invalid REPO_URL") }
    if (!(p('BASE_HREF') ==~ /\/([A-Za-z0-9._-]+\/)*/)) { error("Invalid BASE_HREF (must start and end with /)") }
    if (!(p('BUILD_MODE') in ['release', 'debug', 'profile'])) { error("Invalid BUILD_MODE") }
    if (!(p('NEXUS_URL') ==~ /https?:\/\/[A-Za-z0-9._:\/-]+/)) { error("Invalid NEXUS_URL") }
    if (!(p('FLUTTER_IMAGE') ==~ /[A-Za-z0-9._\/-]+(:[A-Za-z0-9._-]+)?/)) { error("Invalid FLUTTER_IMAGE") }
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    parameters {
        string(name: 'REPO_URL', defaultValue: 'https://git.fintechcenterfsa.com/frontend/super-app.git', description: 'Super App source repository')
        string(name: 'BRANCH', defaultValue: 'development', description: 'Branch to build')
        string(name: 'GIT_CREDENTIALS_ID', defaultValue: 'git-action', description: 'Jenkins credential for REPO_URL')
        string(name: 'BASE_HREF', defaultValue: '/superapp-sandbox/', description: 'Base href where the Backoffice serves the sandbox')
        choice(name: 'BUILD_MODE', choices: ['release', 'debug', 'profile'], description: 'Flutter Web build mode')
        booleanParam(name: 'DEPLOY_SANDBOX', defaultValue: true, description: 'Copy build/web to SANDBOX_OUTPUT_DIR (the live sandbox)')
        booleanParam(name: 'PUBLISH_TO_NEXUS', defaultValue: false, description: 'Also upload superapp-sandbox.tar.gz to Nexus superapp-artifacts')
        string(name: 'NEXUS_URL', defaultValue: 'https://app.fintechcenterfsa.com/nexus', description: 'Sonatype Nexus URL')
        string(name: 'NEXUS_USER', defaultValue: 'admin', description: 'Nexus user (for PUBLISH_TO_NEXUS)')
        password(name: 'NEXUS_PASSWORD', defaultValue: '', description: 'Nexus password (for PUBLISH_TO_NEXUS)')
        string(name: 'FLUTTER_IMAGE', defaultValue: 'ghcr.io/cirruslabs/flutter:3.44.0', description: 'Docker image with Flutter')
        string(name: 'PUB_GATEWAY_URL', defaultValue: 'https://app.fintechcenterfsa.com/pub', description: 'Pub registry the Super App pubspec.yaml uses for mini app packages; the build reads it with CALLBACK_TOKEN')
        string(name: 'PRIVATE_GIT_DEPS', defaultValue: 'https://github.com/KhornMolika/sc-private-miniapp.git=github-sc-private-miniapp', description: 'Private Git dependencies: <https url>=<Jenkins SSH deploy-key credential id>, comma separated')
        string(name: 'CALLBACK_URL', defaultValue: '', description: 'Unused (see the note at the top); accepted so the backend can still trigger the job')
        string(name: 'CALLBACK_TOKEN', defaultValue: '', description: 'Build token: reads mini app packages from PUB_GATEWAY_URL (no callbacks are sent)')
    }

    environment {
        MOBILE_DIR = 'mobile'
        SANDBOX_OUTPUT_DIR = '/var/reports/superapp-sandbox'
    }

    stages {
        stage('1. Pre-Flight & Checkout') {
            steps {
                script {
                    validateParams()
                    echo "Sandbox from ${p('REPO_URL')} @ ${p('BRANCH')}, base href ${p('BASE_HREF')}, ${p('BUILD_MODE')}, image ${p('FLUTTER_IMAGE')}"
                    dir(env.MOBILE_DIR) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${p('BRANCH')}"]],
                            userRemoteConfigs: [[url: p('REPO_URL'), credentialsId: p('GIT_CREDENTIALS_ID')]],
                            extensions: [[$class: 'CloneOption', depth: 1, shallow: true, noTags: true],
                                         [$class: 'CleanBeforeCheckout']]])
                    }
                    def local = sh(returnStdout: true, script: "grep -nE 'url: *https?://(localhost|127\\.0\\.0\\.1|10\\.0\\.2\\.2|host\\.docker\\.internal)' ${env.MOBILE_DIR}/pubspec.yaml || true").trim()
                    if (local) {
                        error("pubspec.yaml uses a package registry on a developer PC, which this build cannot reach:\n${local}\nPublish those packages to the production Nexus and point pubspec.yaml at it.")
                    }
                }
            }
        }

        stage('2. Build Flutter Web') {
            steps {
                script {
                    withPrivateGitDeps {
                    withEnv(["FLUTTER_IMAGE=${p('FLUTTER_IMAGE')}", "PUB_GATEWAY_URL=${p('PUB_GATEWAY_URL')}", "BASE_HREF=${p('BASE_HREF')}", "BUILD_MODE=${p('BUILD_MODE')}"]) {
                        sh '''
                            set -e
                            S="$WORKSPACE/.ci-secrets"
                            if [ -f "$S/gitconfig" ]; then
                                export GIT_SSH_COMMAND="ssh -F $S/ssh_config" GIT_DEPS_CONFIG="$S/gitconfig"
                            fi
                            export FSA_PUB_TOKEN="${CALLBACK_TOKEN:-}"
                            CACHE_DIR="$WORKSPACE/.ci-cache"
                            mkdir -p "$CACHE_DIR/pub"
                            # Jenkins runs in a container that talks to the host's Docker: share its
                            # volumes so the build container sees this workspace at the same path.
                            SELF=$(cat /etc/hostname)
                            if docker inspect "$SELF" >/dev/null 2>&1; then MOUNT="--volumes-from $SELF"
                            else MOUNT="-v $WORKSPACE:$WORKSPACE"; fi

                            docker run --rm $MOUNT -w "$WORKSPACE/$MOBILE_DIR" --memory 4g --cpus 2 \
                                -e PUB_CACHE="$CACHE_DIR/pub" -e BASE_HREF -e BUILD_MODE \
                                -e GIT_SSH_COMMAND -e GIT_DEPS_CONFIG -e FSA_PUB_TOKEN -e PUB_GATEWAY_URL \
                                -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
                                "$FLUTTER_IMAGE" bash -ec '
                                    trap "chown -R $HOST_UID:$HOST_GID . $PUB_CACHE 2>/dev/null || true" EXIT
                                    git config --global --add safe.directory "*"
                                    if [ -n "${GIT_DEPS_CONFIG:-}" ]; then git config --global include.path "$GIT_DEPS_CONFIG"; fi
                                    # Mini app packages come from the /pub gateway; the build token reads them (never written to disk)
                                    if [ -n "${FSA_PUB_TOKEN:-}" ]; then dart pub token add "$PUB_GATEWAY_URL" --env-var FSA_PUB_TOKEN; fi
                                    flutter --version
                                    flutter pub get
                                    flutter build web --base-href "$BASE_HREF" --$BUILD_MODE
                                '
                            test -f "$MOBILE_DIR/build/web/index.html" || { echo "No build/web/index.html"; exit 1; }
                            tar -czf superapp-sandbox.tar.gz -C "$MOBILE_DIR/build/web" .
                            ls -l superapp-sandbox.tar.gz
                        '''
                    }
                    }
                    archiveArtifacts artifacts: 'superapp-sandbox.tar.gz', fingerprint: true
                }
            }
        }

        stage('3. Deploy sandbox') {
            when { expression { p('DEPLOY_SANDBOX') } }
            steps {
                sh '''
                    set -e
                    mkdir -p "$SANDBOX_OUTPUT_DIR"
                    # Replace the old files, so removed assets do not linger
                    find "$SANDBOX_OUTPUT_DIR" -mindepth 1 -delete
                    cp -R "$MOBILE_DIR/build/web/." "$SANDBOX_OUTPUT_DIR/"
                    echo "Sandbox deployed to $SANDBOX_OUTPUT_DIR"
                '''
            }
        }

        stage('4. Publish to Nexus') {
            when { expression { p('PUBLISH_TO_NEXUS') } }
            steps {
                script {
                    withEnv(["UPLOAD_URL=${p('NEXUS_URL')}/repository/superapp-artifacts/sandbox/latest/superapp-sandbox.tar.gz",
                             "NEXUS_USER=${p('NEXUS_USER')}"]) {
                        sh '''
                            set -e
                            printf 'user = "%s:%s"\\n' "$NEXUS_USER" "${NEXUS_PASSWORD:-}" \
                                | curl -sSf -K - --upload-file superapp-sandbox.tar.gz "$UPLOAD_URL" > /dev/null
                            echo "Uploaded $UPLOAD_URL"
                        '''
                    }
                }
            }
        }
    }
}
