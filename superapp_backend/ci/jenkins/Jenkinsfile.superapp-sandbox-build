// Super App Flutter Web sandbox (the Backoffice preview at /superapp-sandbox/):
// compiles inside Jenkins with the Flutter Docker image, then copies build/web to
// SANDBOX_OUTPUT_DIR and, optionally, uploads an archive to Nexus.
//
// It sends no build callback: /release-assembly/build-callback moves every BUILDING
// mini app to TESTING, which a sandbox rebuild must never do.
def p(String name) {
    // Parameters added after the job was created are null on the first run with this file
    def defaults = [
        REPO_URL: 'https://git.fintechcenterfsa.com/frontend/super-app.git',
        BRANCH: 'development',
        GIT_CREDENTIALS_ID: 'git-action',
        BASE_HREF: '/superapp-sandbox/',
        BUILD_MODE: 'release',
        FLUTTER_IMAGE: 'ghcr.io/cirruslabs/flutter:3.44.0',
        DEPLOY_SANDBOX: true,
        PUBLISH_TO_NEXUS: true,
        API_BASE_URL: 'https://app.fintechcenterfsa.com/api',
        NEXUS_URL: 'https://app.fintechcenterfsa.com/nexus',
        NEXUS_USER: 'admin',
        PRIVATE_GIT_DEPS: '',
        BUILD_CREDENTIALS_URL: '',
        MINIAPPS_URL: '',
        PUB_GATEWAY_URL: 'https://app.fintechcenterfsa.com/pub',
    ]
    def v = params[name]
    return (v == null || v == '') ? defaults[name] : v
}

/** Private Git dependencies of the Super App: "<https url>=<Jenkins SSH credential id>", comma separated. */
def privateGitDeps() {
    def deps = []
    for (entry in (p('PRIVATE_GIT_DEPS') ?: '').split(',')) {
        def e = entry.trim()
        if (!e) continue
        def parts = e.split('=', 2)
        if (parts.length != 2 || !(parts[0] ==~ /https:\/\/github\.com\/[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+\.git/) || !(parts[1] ==~ /[A-Za-z0-9._-]+/)) {
            error("Invalid PRIVATE_GIT_DEPS entry: ${e}")
        }
        deps << [url: parts[0], cred: parts[1]]
    }
    return deps
}

/** Backend list of each in-build mini app's private repository and its key. */
def gitCredentialsUrl() {
    def explicit = (p('BUILD_CREDENTIALS_URL') ?: '').trim()
    if (explicit) return explicit
    def base = (params.CALLBACK_URL ?: '').trim()
    return base ? base.replaceAll('/build-callback/?$', '/build-git-credentials') : ''
}

/** Backend list of the Flutter mini apps in this build (pubspec entries and registry, no secrets). */
def miniAppsUrl() {
    def explicit = (p('MINIAPPS_URL') ?: '').trim()
    if (explicit) return explicit
    def base = (params.CALLBACK_URL ?: '').trim()
    return base ? base.replaceAll('/build-callback/?$', '/build-miniapps') : ''
}

/**
 * Rewrites the Super App's mini app packages (pubspec.yaml and the generated
 * registry) from the backend list, so an app added or deleted in this
 * environment is never out of date in the super-app repository. Runs
 * tool/sync_miniapps.dart in the Flutter image, before pub get.
 */
def syncMiniApps() {
    def url = miniAppsUrl()
    if (!url) {
        echo 'WARNING: no backend URL (CALLBACK_URL / MINIAPPS_URL): building with the mini apps committed in super-app'
        return
    }
    withEnv(["MINIAPPS_LIST_URL=${url}", "FLUTTER_IMAGE=${p('FLUTTER_IMAGE')}"]) {
        sh '''
            set -e
            LIST="$WORKSPACE/build-miniapps.json"
            rm -f "$LIST"
            code=$(curl -sS --max-time 30 -o "$LIST" -w '%{http_code}' \
                -H "x-callback-token: ${CALLBACK_TOKEN:-}" "$MINIAPPS_LIST_URL") || code=error
            if [ "$code" = "404" ]; then
                echo "WARNING: this backend has no build-miniapps yet: building with the mini apps committed in super-app"
                rm -f "$LIST"; exit 0
            elif [ "$code" != "200" ]; then
                echo "Could not read the mini app list from $MINIAPPS_LIST_URL (HTTP $code)"; exit 1
            fi
            if [ ! -f "$MOBILE_DIR/tool/sync_miniapps.dart" ]; then
                echo "WARNING: this super-app branch has no tool/sync_miniapps.dart: building with its committed mini apps"
                exit 0
            fi
            SELF=$(cat /etc/hostname)
            if docker inspect "$SELF" >/dev/null 2>&1; then MOUNT="--volumes-from $SELF"
            else MOUNT="-v $WORKSPACE:$WORKSPACE"; fi
            docker run --rm $MOUNT -w "$WORKSPACE" -e MOBILE_DIR -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
                "$FLUTTER_IMAGE" bash -ec '
                    trap "chown -R $HOST_UID:$HOST_GID $MOBILE_DIR 2>/dev/null || true" EXIT
                    dart "$MOBILE_DIR/tool/sync_miniapps.dart" build-miniapps.json "$MOBILE_DIR"
                '
        '''
    }
    if (fileExists('build-miniapps.json')) archiveArtifacts artifacts: 'build-miniapps.json', fingerprint: true
}

/** Turns git-credentials.json into an SSH config, key files and Git insteadOf rules (no backslashes: kept in a Groovy string). */
def gitConfigJs() {
    return '''
const fs = require('fs');
const S = process.argv[2];
const NL = String.fromCharCode(10), TAB = String.fromCharCode(9);
const data = JSON.parse(fs.readFileSync(S + '/git-credentials.json', 'utf8'));
let ssh = '', git = '', n = 0;
for (const c of data.credentials || []) {
  const i = n++;
  if (c.type === 'ssh') {
    fs.writeFileSync(S + '/app_key_' + i, c.privateKey, { mode: 0o600 });
    ssh += ['Host app-dep-' + i, '  HostName ' + c.host, '  User git', '  IdentityFile ' + S + '/app_key_' + i,
            '  IdentitiesOnly yes', '  StrictHostKeyChecking accept-new', '  UserKnownHostsFile ' + S + '/known_hosts', ''].join(NL);
    git += '[url "app-dep-' + i + ':' + c.path + '"]' + NL + TAB + 'insteadOf = ' + c.repoUrl + NL;
  } else if (c.type === 'token') {
    git += '[url "https://oauth2:' + encodeURIComponent(c.token) + '@' + c.host + '/' + c.path + '"]' + NL + TAB + 'insteadOf = ' + c.repoUrl + NL;
  }
  console.log('Private repository for ' + c.appId + ': ' + c.repoUrl + ' (' + c.type + ')');
}
fs.appendFileSync(S + '/ssh_config', ssh, { mode: 0o600 });
fs.appendFileSync(S + '/gitconfig', git, { mode: 0o600 });
for (const s of data.skipped || []) console.log('WARNING: ' + s.appId + ': ' + s.reason);
console.log('Private mini app repositories: ' + n);
'''
}

/**
 * Runs body with the private Git repositories of the mini apps in this build
 * reachable: each with the deploy key or token its developer registered
 * (backend build-git-credentials), plus any extra PRIVATE_GIT_DEPS entries
 * from Jenkins credentials. Writes $WORKSPACE/.ci-secrets (SSH config, keys,
 * a Git insteadOf per repository, so other URLs stay anonymous) and always
 * removes it afterwards; nothing there is archived or uploaded.
 */
def withPrivateGitDeps(Closure body) {
    def deps = privateGitDeps()
    def bindings = []
    def list = []
    for (int i = 0; i < deps.size(); i++) {
        bindings << sshUserPrivateKey(credentialsId: deps[i].cred, keyFileVariable: "GIT_DEP_KEY_${i}")
        list << "${i}|${deps[i].url}"
    }
    sh 'S="$WORKSPACE/.ci-secrets"; rm -rf "$S"; mkdir -p "$S"; chmod 700 "$S"; : > "$S/ssh_config"; : > "$S/gitconfig"'
    try {
        def credsUrl = gitCredentialsUrl()
        if (credsUrl) {
            writeFile file: '.ci-secrets/write-git-config.js', text: gitConfigJs()
            withEnv(["GIT_CREDS_URL=${credsUrl}"]) {
                sh '''
                    set -e
                    S="$WORKSPACE/.ci-secrets"
                    code=$(curl -sS --max-time 30 -o "$S/git-credentials.json" -w '%{http_code}' \
                        -H "x-callback-token: ${CALLBACK_TOKEN:-}" "$GIT_CREDS_URL") || code=error
                    chmod 600 "$S/git-credentials.json" 2>/dev/null || true
                    if [ "$code" = "200" ]; then
                        node "$S/write-git-config.js" "$S"
                    elif [ "$code" = "404" ]; then
                        echo "WARNING: this backend has no build-git-credentials yet; private mini app repositories are not set up"
                    else
                        echo "Could not read private repository keys from $GIT_CREDS_URL (HTTP $code)"; exit 1
                    fi
                    rm -f "$S/git-credentials.json"
                '''
            }
        } else {
            echo 'WARNING: no backend URL for private repository keys (CALLBACK_URL / BUILD_CREDENTIALS_URL); only PRIVATE_GIT_DEPS is used'
        }
        if (deps) {
            withCredentials(bindings) {
                withEnv(["GIT_DEP_LIST=${list.join('\n')}"]) {
                    sh '''
                        set -e
                        S="$WORKSPACE/.ci-secrets"
                        printf '%s\\n' "$GIT_DEP_LIST" | while IFS='|' read -r i url; do
                            [ -n "$url" ] || continue
                            cp "$(printenv "GIT_DEP_KEY_$i")" "$S/jk_key_$i"; chmod 600 "$S/jk_key_$i"
                            printf 'Host jk-dep-%s\\n  HostName github.com\\n  User git\\n  IdentityFile %s\\n  IdentitiesOnly yes\\n  StrictHostKeyChecking accept-new\\n  UserKnownHostsFile %s/known_hosts\\n' "$i" "$S/jk_key_$i" "$S" >> "$S/ssh_config"
                            printf '[url "jk-dep-%s:%s"]\\n\\tinsteadOf = %s\\n' "$i" "${url#https://github.com/}" "$url" >> "$S/gitconfig"
                        done
                        echo "Extra private repositories (PRIVATE_GIT_DEPS): $(grep -c 'jk-dep-' "$S/gitconfig" || true)"
                    '''
                }
            }
        }
        body()
    } finally {
        sh 'rm -rf "$WORKSPACE/.ci-secrets"'
    }
}

def validateParams() {
    if (!(p('BRANCH') ==~ /[A-Za-z0-9._\/-]{1,100}/)) { error("Invalid BRANCH") }
    if (!(p('REPO_URL') ==~ /https:\/\/[A-Za-z0-9._:\/-]+\.git/)) { error("Invalid REPO_URL") }
    if (!(p('BASE_HREF') ==~ /\/([A-Za-z0-9._-]+\/)*/)) { error("Invalid BASE_HREF (must start and end with /)") }
    if (!(p('BUILD_MODE') in ['release', 'debug', 'profile'])) { error("Invalid BUILD_MODE") }
    if (!(p('API_BASE_URL') ==~ /https?:\/\/[A-Za-z0-9._:\/-]+/)) { error("Invalid API_BASE_URL") }
    if (!(p('NEXUS_URL') ==~ /https?:\/\/[A-Za-z0-9._:\/-]+/)) { error("Invalid NEXUS_URL") }
    if (!(p('FLUTTER_IMAGE') ==~ /[A-Za-z0-9._\/-]+(:[A-Za-z0-9._-]+)?/)) { error("Invalid FLUTTER_IMAGE") }
}

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    parameters {
        string(name: 'REPO_URL', defaultValue: 'https://git.fintechcenterfsa.com/frontend/super-app.git', description: 'Super App source repository')
        string(name: 'BRANCH', defaultValue: 'development', description: 'Branch to build')
        string(name: 'GIT_CREDENTIALS_ID', defaultValue: 'git-action', description: 'Jenkins credential for REPO_URL')
        string(name: 'BASE_HREF', defaultValue: '/superapp-sandbox/', description: 'Base href where the Backoffice serves the sandbox')
        choice(name: 'BUILD_MODE', choices: ['release', 'debug', 'profile'], description: 'Flutter Web build mode')
        booleanParam(name: 'DEPLOY_SANDBOX', defaultValue: true, description: 'Copy build/web to SANDBOX_OUTPUT_DIR (the live sandbox)')
        booleanParam(name: 'PUBLISH_TO_NEXUS', defaultValue: true, description: 'Upload the web build to Nexus superapp-artifacts/superapp-web (the Backoffice preview and /preview/ serve the newest one)')
        string(name: 'API_BASE_URL', defaultValue: 'https://app.fintechcenterfsa.com/api', description: 'Backend URL the web Super App talks to')
        string(name: 'NEXUS_URL', defaultValue: 'https://app.fintechcenterfsa.com/nexus', description: 'Sonatype Nexus URL')
        string(name: 'NEXUS_USER', defaultValue: 'admin', description: 'Nexus user (for PUBLISH_TO_NEXUS)')
        password(name: 'NEXUS_PASSWORD', defaultValue: '', description: 'Nexus password (for PUBLISH_TO_NEXUS)')
        string(name: 'FLUTTER_IMAGE', defaultValue: 'ghcr.io/cirruslabs/flutter:3.44.0', description: 'Docker image with Flutter')
        string(name: 'PUB_GATEWAY_URL', defaultValue: 'https://app.fintechcenterfsa.com/pub', description: 'Pub registry the Super App pubspec.yaml uses for mini app packages; the build reads it with CALLBACK_TOKEN')
        string(name: 'PRIVATE_GIT_DEPS', defaultValue: '', description: 'Extra private Git dependencies not registered as mini apps: <https url>=<Jenkins SSH deploy-key credential id>, comma separated')
        string(name: 'BUILD_CREDENTIALS_URL', defaultValue: '', description: 'Backend build-git-credentials URL (each mini app private repository key). Empty: derived from CALLBACK_URL.')
        string(name: 'MINIAPPS_URL', defaultValue: '', description: 'Backend build-miniapps URL (the Flutter mini apps in this build). Empty: derived from CALLBACK_URL.')
        string(name: 'CALLBACK_URL', defaultValue: '', description: 'Unused (see the note at the top); accepted so the backend can still trigger the job')
        string(name: 'CALLBACK_TOKEN', defaultValue: '', description: 'Build token: reads mini app packages from PUB_GATEWAY_URL (no callbacks are sent)')
    }

    environment {
        MOBILE_DIR = 'mobile'
        SANDBOX_OUTPUT_DIR = '/var/reports/superapp-sandbox'
    }

    stages {
        stage('1. Pre-Flight & Checkout') {
            steps {
                script {
                    validateParams()
                    echo "Sandbox from ${p('REPO_URL')} @ ${p('BRANCH')}, base href ${p('BASE_HREF')}, ${p('BUILD_MODE')}, image ${p('FLUTTER_IMAGE')}"
                    dir(env.MOBILE_DIR) {
                        checkout([$class: 'GitSCM',
                            branches: [[name: "*/${p('BRANCH')}"]],
                            userRemoteConfigs: [[url: p('REPO_URL'), credentialsId: p('GIT_CREDENTIALS_ID')]],
                            extensions: [[$class: 'CloneOption', depth: 1, shallow: true, noTags: true],
                                         [$class: 'CleanBeforeCheckout']]])
                    }
                    syncMiniApps()
                    def local = sh(returnStdout: true, script: "grep -nE 'url: *https?://(localhost|127\\.0\\.0\\.1|10\\.0\\.2\\.2|host\\.docker\\.internal)' ${env.MOBILE_DIR}/pubspec.yaml || true").trim()
                    if (local) {
                        error("pubspec.yaml uses a package registry on a developer PC, which this build cannot reach:\n${local}\nPublish those packages to the production Nexus and point pubspec.yaml at it.")
                    }
                }
            }
        }

        stage('2. Build Flutter Web') {
            steps {
                script {
                    withPrivateGitDeps {
                    withEnv(["FLUTTER_IMAGE=${p('FLUTTER_IMAGE')}", "PUB_GATEWAY_URL=${p('PUB_GATEWAY_URL')}", "BASE_HREF=${p('BASE_HREF')}", "BUILD_MODE=${p('BUILD_MODE')}", "API_BASE_URL=${p('API_BASE_URL')}"]) {
                        sh '''
                            set -e
                            S="$WORKSPACE/.ci-secrets"
                            if [ -f "$S/gitconfig" ]; then
                                export GIT_SSH_COMMAND="ssh -F $S/ssh_config" GIT_DEPS_CONFIG="$S/gitconfig"
                            fi
                            export FSA_PUB_TOKEN="${CALLBACK_TOKEN:-}"
                            CACHE_DIR="$WORKSPACE/.ci-cache"
                            mkdir -p "$CACHE_DIR/pub"
                            # Jenkins runs in a container that talks to the host's Docker: share its
                            # volumes so the build container sees this workspace at the same path.
                            SELF=$(cat /etc/hostname)
                            if docker inspect "$SELF" >/dev/null 2>&1; then MOUNT="--volumes-from $SELF"
                            else MOUNT="-v $WORKSPACE:$WORKSPACE"; fi

                            docker run --rm $MOUNT -w "$WORKSPACE/$MOBILE_DIR" --memory 4g --cpus 2 \
                                -e PUB_CACHE="$CACHE_DIR/pub" -e BASE_HREF -e BUILD_MODE -e API_BASE_URL \
                                -e GIT_SSH_COMMAND -e GIT_DEPS_CONFIG -e FSA_PUB_TOKEN -e PUB_GATEWAY_URL \
                                -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
                                "$FLUTTER_IMAGE" bash -ec '
                                    trap "chown -R $HOST_UID:$HOST_GID . $PUB_CACHE 2>/dev/null || true" EXIT
                                    git config --global --add safe.directory "*"
                                    if [ -n "${GIT_DEPS_CONFIG:-}" ]; then git config --global include.path "$GIT_DEPS_CONFIG"; fi
                                    # Mini app packages come from the /pub gateway; the build token reads them (never written to disk)
                                    if [ -n "${FSA_PUB_TOKEN:-}" ]; then dart pub token add "$PUB_GATEWAY_URL" --env-var FSA_PUB_TOKEN; fi
                                    flutter --version
                                    flutter pub get
                                    flutter build web --base-href "$BASE_HREF" --$BUILD_MODE --dart-define=API_BASE_URL="$API_BASE_URL"
                                '
                            test -f "$MOBILE_DIR/build/web/index.html" || { echo "No build/web/index.html"; exit 1; }
                            tar -czf superapp-sandbox.tar.gz -C "$MOBILE_DIR/build/web" .
                            ls -l superapp-sandbox.tar.gz
                        '''
                    }
                    }
                    archiveArtifacts artifacts: 'superapp-sandbox.tar.gz', fingerprint: true
                }
            }
        }

        stage('3. Deploy sandbox') {
            when { expression { p('DEPLOY_SANDBOX') } }
            steps {
                sh '''
                    set -e
                    mkdir -p "$SANDBOX_OUTPUT_DIR"
                    # Replace the old files, so removed assets do not linger
                    find "$SANDBOX_OUTPUT_DIR" -mindepth 1 -delete
                    cp -R "$MOBILE_DIR/build/web/." "$SANDBOX_OUTPUT_DIR/"
                    echo "Sandbox deployed to $SANDBOX_OUTPUT_DIR"
                '''
            }
        }

        stage('4. Publish to Nexus') {
            when { expression { p('PUBLISH_TO_NEXUS') } }
            steps {
                script {
                    // The backend serves the newest build (latest.json) at the Backoffice
                    // preview (/superapp-sandbox/) and the web Super App (/preview/)
                    withEnv(["REPO_BASE=${p('NEXUS_URL')}/repository/superapp-artifacts/superapp-web",
                             "NEXUS_USER=${p('NEXUS_USER')}"]) {
                        sh '''
                            set -e
                            ARCHIVE="superapp-web/$BUILD_NUMBER/superapp-web.tar.gz"
                            COMMIT=$(git -C "$MOBILE_DIR" rev-parse --short HEAD 2>/dev/null || echo unknown)
                            printf '{"build":%s,"archive":"%s","commit":"%s","builtAt":"%s"}\\n' \
                                "$BUILD_NUMBER" "$ARCHIVE" "$COMMIT" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > latest.json
                            auth() { printf 'user = "%s:%s"\\n' "$NEXUS_USER" "${NEXUS_PASSWORD:-}"; }
                            auth | curl -sSf -K - --upload-file superapp-sandbox.tar.gz "$REPO_BASE/$BUILD_NUMBER/superapp-web.tar.gz" > /dev/null
                            # latest.json last, so it never points at a missing archive
                            auth | curl -sSf -K - -H "Content-Type: application/json" --upload-file latest.json "$REPO_BASE/latest.json" > /dev/null
                            echo "Published web build $BUILD_NUMBER ($COMMIT) to $REPO_BASE"
                        '''
                    }
                }
            }
        }
    }
}
