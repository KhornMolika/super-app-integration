pipeline {
    agent any

    parameters {
        choice(name: 'SERVICE', choices: ['all', 'backend', 'manager-client', 'client'], description: 'Service(s) to compile and push to Harbor')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag (e.g., latest, v1.0.6, or commit SHA)')
        string(name: 'GIT_BRANCH', defaultValue: 'molika', description: 'Target Git branch to build from')
        booleanParam(name: 'RUN_TESTS', defaultValue: true, description: 'Run lint, typecheck, and unit tests before Docker build')
        string(name: 'HARBOR_REGISTRY', defaultValue: 'registry.fintechcenterfsa.com', description: 'Harbor Registry Host')
        string(name: 'HARBOR_PROJECT', defaultValue: 'super-app', description: 'Harbor Project / Repository Namespace')
    }

    environment {
        HARBOR_REGISTRY = "${params.HARBOR_REGISTRY ?: 'registry.fintechcenterfsa.com'}"
        HARBOR_PROJECT  = "${params.HARBOR_PROJECT ?: 'super-app'}"
        BACKEND_GIT_URL = 'https://git.fintechcenterfsa.com/backend/super-app.git'
        MANAGER_GIT_URL = 'https://git.fintechcenterfsa.com/frontend/super-app-manager.git'
        CLIENT_GIT_URL  = 'https://git.fintechcenterfsa.com/frontend/super-app.git'
        GIT_CREDENTIALS = 'git-action'
        HARBOR_CREDS_ID = 'harbor-credentials'
    }

    stages {
        stage('1. Pre-Flight & Workspace Preparation') {
            steps {
                echo "=========================================================="
                echo " [*] Super App Automated Harbor Container CI Pipeline"
                echo " Target Service  : ${params.SERVICE}"
                echo " Image Tag       : ${params.IMAGE_TAG}"
                echo " Git Branch      : ${params.GIT_BRANCH}"
                echo " Registry        : ${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}"
                echo " Run Tests       : ${params.RUN_TESTS}"
                echo " Final Action    : Build & Push to Harbor"
                echo "=========================================================="

                script {
                    // Authenticate with Harbor Registry if credentials exist
                    try {
                        withCredentials([usernamePassword(credentialsId: env.HARBOR_CREDS_ID, usernameVariable: 'H_USER', passwordVariable: 'H_PASS')]) {
                            sh 'echo "$H_PASS" | docker login "${HARBOR_REGISTRY}" -u "$H_USER" --password-stdin'
                            echo "[INFO] Successfully authenticated against Harbor registry: ${env.HARBOR_REGISTRY}"
                        }
                    } catch (Exception credErr) {
                        echo "[WARN] Could not authenticate via Jenkins credential '${env.HARBOR_CREDS_ID}': ${credErr.message}"
                        echo "[WARN] Attempting to continue using existing Docker daemon auth..."
                    }
                }
            }
        }

        stage('2. Quality Gate & Automated Testing') {
            when { expression { return params.RUN_TESTS == true } }
            steps {
                script {
                    echo "=== Running Code Quality Checks & Verification ==="
                    
                    // Backend verification
                    if (params.SERVICE == 'all' || params.SERVICE == 'backend') {
                        echo "[Backend] Verifying NestJS code and running tests..."
                        sh """
                        TARGET_DIR="."
                        if [ -d "superapp_backend" ]; then
                            TARGET_DIR="superapp_backend"
                        fi

                        if [ -f "\$TARGET_DIR/package.json" ]; then
                            cd "\$TARGET_DIR"
                            corepack enable && pnpm install --frozen-lockfile || npm install
                            pnpm exec tsc --noEmit || ./node_modules/.bin/tsc --noEmit || true
                            pnpm test --passWithNoTests || true
                        fi
                        """
                    }

                    // Backoffice verification
                    if (params.SERVICE == 'all' || params.SERVICE == 'manager-client') {
                        echo "[Backoffice] Verifying Next.js TypeScript compilation..."
                        sh """
                        TARGET_DIR="."
                        if [ -d "superapp_backoffice" ]; then
                            TARGET_DIR="superapp_backoffice"
                        fi

                        if [ -f "\$TARGET_DIR/package.json" ] && [ -f "\$TARGET_DIR/next.config.mjs" -o -f "\$TARGET_DIR/next.config.ts" -o -f "\$TARGET_DIR/next.config.js" ]; then
                            cd "\$TARGET_DIR"
                            corepack enable && pnpm install --frozen-lockfile || npm install
                            pnpm exec tsc --noEmit || ./node_modules/.bin/tsc --noEmit || true
                        fi
                        """
                    }
                }
            }
        }

        stage('3. Build & Push: super-app-backend') {
            when { expression { return params.SERVICE == 'all' || params.SERVICE == 'backend' } }
            steps {
                script {
                    def imgRuntime = "${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}/backend:${params.IMAGE_TAG}"
                    def imgMigrator = "${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}/backend:migrator"

                    echo "=== Building Backend Images: ${imgRuntime} and ${imgMigrator} ==="
                    sh """
                    BUILD_DIR="."
                    if [ -d "superapp_backend" ]; then
                        BUILD_DIR="superapp_backend"
                    elif [ ! -f "Dockerfile" ]; then
                        echo "Cloning backend repository from ${env.BACKEND_GIT_URL} (branch ${params.GIT_BRANCH})..."
                        rm -rf _build_backend
                        git clone --depth 1 -b ${params.GIT_BRANCH} ${env.BACKEND_GIT_URL} _build_backend
                        BUILD_DIR="_build_backend"
                    fi

                    echo "Using backend build directory: \$BUILD_DIR"
                    cd "\$BUILD_DIR"

                    # 1. Main runtime API image
                    echo "Building ${imgRuntime}..."
                    docker build --platform linux/amd64 \
                        -t "${imgRuntime}" \
                        .
                    docker push "${imgRuntime}"

                    # 2. Database migrator initContainer image
                    echo "Building ${imgMigrator}..."
                    docker build --platform linux/amd64 \
                        --target migrator \
                        -t "${imgMigrator}" \
                        .
                    docker push "${imgMigrator}"

                    echo "[OK] Successfully pushed backend images to Harbor!"
                    """
                }
            }
        }

        stage('4. Build & Push: super-app-manager-client') {
            when { expression { return params.SERVICE == 'all' || params.SERVICE == 'manager-client' } }
            steps {
                script {
                    def imgManager = "${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}/manager-client:${params.IMAGE_TAG}"

                    echo "=== Building Backoffice Manager Image: ${imgManager} ==="
                    sh """
                    BUILD_DIR="."
                    if [ -d "superapp_backoffice" ]; then
                        BUILD_DIR="superapp_backoffice"
                    elif [ ! -f "next.config.mjs" ] && [ ! -f "next.config.ts" ] && [ ! -f "next.config.js" ]; then
                        echo "Cloning manager repository from ${env.MANAGER_GIT_URL} (branch ${params.GIT_BRANCH})..."
                        rm -rf _build_manager
                        git clone --depth 1 -b ${params.GIT_BRANCH} ${env.MANAGER_GIT_URL} _build_manager
                        BUILD_DIR="_build_manager"
                    fi

                    echo "Using manager build directory: \$BUILD_DIR"
                    cd "\$BUILD_DIR"

                    docker build --platform linux/amd64 \
                        --build-arg NEXT_PUBLIC_SOCKET_URL=https://app.fintechcenterfsa.com \
                        --build-arg NEXT_PUBLIC_ENVIRONMENT=PROD \
                        --build-arg NEXT_PUBLIC_NEXUS_URL=https://app.fintechcenterfsa.com/nexus \
                        --build-arg NEXT_PUBLIC_MINIO_URL=https://app.fintechcenterfsa.com/api/storage \
                        --build-arg NEXT_PUBLIC_JENKINS_URL=https://app.fintechcenterfsa.com/jenkins \
                        --build-arg NEXT_PUBLIC_MOBILE_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git \
                        --build-arg NEXT_PUBLIC_SUPERAPP_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git \
                        --build-arg NEXT_PUBLIC_SUPERAPP_SANDBOX_URL=/superapp-sandbox/index.html \
                        --build-arg NEXT_PUBLIC_PREVIEW_ENABLED=true \
                        --build-arg NEXT_PUBLIC_PREVIEW_ALLOW_LOCALHOST=false \
                        --build-arg NEXT_PUBLIC_PREVIEW_REQUIRE_HTTPS=true \
                        --build-arg NEXT_PUBLIC_PREVIEW_SESSION_TIMEOUT=3600 \
                        -t "${imgManager}" \
                        .
                    docker push "${imgManager}"

                    echo "[OK] Successfully pushed manager-client to Harbor!"
                    """
                }
            }
        }

        stage('5. Build & Push: super-app-client (Flutter Web)') {
            when { expression { return params.SERVICE == 'all' || params.SERVICE == 'client' } }
            steps {
                script {
                    def imgClient = "${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}/client:${params.IMAGE_TAG}"

                    echo "=== Building Flutter Web Client: ${imgClient} ==="
                    sh """
                    BUILD_DIR="."
                    if [ -d "super-app" ]; then
                        BUILD_DIR="super-app"
                    elif [ ! -f "pubspec.yaml" ]; then
                        echo "Cloning Flutter client repository from ${env.CLIENT_GIT_URL} (branch development)..."
                        rm -rf _build_client
                        git clone --depth 1 -b development ${env.CLIENT_GIT_URL} _build_client
                        BUILD_DIR="_build_client"
                    fi

                    echo "Using Flutter client build directory: \$BUILD_DIR"
                    cd "\$BUILD_DIR"

                    docker build --platform linux/amd64 \
                        --build-arg BASE_HREF=/preview/ \
                        --build-arg API_BASE_URL=https://app.fintechcenterfsa.com/api \
                        -t "${imgClient}" \
                        .
                    docker push "${imgClient}"

                    echo "[OK] Successfully pushed client image to Harbor!"
                    """
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout "${HARBOR_REGISTRY}" || true'
            sh 'rm -rf _build_backend _build_manager _build_client || true'
        }
        success {
            echo "=========================================================="
            echo " [SUCCESS] All images built and pushed to Harbor successfully!"
            echo " Service Target : ${params.SERVICE}"
            echo " Image Tag      : ${params.IMAGE_TAG}"
            echo " Harbor Host    : ${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}"
            echo " Pipeline finished (No pod restart executed)."
            echo "=========================================================="
        }
        failure {
            echo "=========================================================="
            echo " [FAILURE] Container CI Pipeline encountered an error."
            echo " Check the console log above for details."
            echo "=========================================================="
        }
    }
}
