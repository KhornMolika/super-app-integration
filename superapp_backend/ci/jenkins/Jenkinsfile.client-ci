pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag (e.g. latest, v1.0.6, or commit SHA)')
        string(name: 'GIT_BRANCH', defaultValue: 'development', description: 'Git branch to build from')
        string(name: 'BASE_HREF', defaultValue: '/preview/', description: 'Base href for Flutter Web hosting')
        string(name: 'API_BASE_URL', defaultValue: 'https://app.fintechcenterfsa.com/api', description: 'Backend API Base URL baked into client')
        string(name: 'HARBOR_REGISTRY', defaultValue: 'registry.fintechcenterfsa.com', description: 'Harbor Registry Host')
        string(name: 'HARBOR_PROJECT', defaultValue: 'super-app', description: 'Harbor Project / Namespace')
    }

    environment {
        HARBOR_REGISTRY = "${params.HARBOR_REGISTRY ?: 'registry.fintechcenterfsa.com'}"
        HARBOR_PROJECT  = "${params.HARBOR_PROJECT ?: 'super-app'}"
        HARBOR_CREDS_ID = 'harbor-credentials'
    }

    stages {
        stage('1. Pre-Flight & Registry Authentication') {
            steps {
                echo "=========================================================="
                echo " [*] SuperApp Flutter Web Client Automated Harbor CI Pipeline"
                echo " Repository      : frontend/super-app"
                echo " Branch          : ${params.GIT_BRANCH}"
                echo " Target Tag      : ${params.IMAGE_TAG}"
                echo " Base Href       : ${params.BASE_HREF}"
                echo " Registry        : ${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}"
                echo " Final Action    : Build & Push to Harbor"
                echo "=========================================================="

                script {
                    try {
                        withCredentials([usernamePassword(credentialsId: env.HARBOR_CREDS_ID, usernameVariable: 'H_USER', passwordVariable: 'H_PASS')]) {
                            sh 'echo "$H_PASS" | docker login "${HARBOR_REGISTRY}" -u "$H_USER" --password-stdin'
                            echo "[INFO] Successfully authenticated against Harbor registry: ${env.HARBOR_REGISTRY}"
                        }
                    } catch (Exception credErr) {
                        echo "[WARN] Could not authenticate via credential '${env.HARBOR_CREDS_ID}': ${credErr.message}"
                        echo "[WARN] Attempting to continue using existing Docker daemon login..."
                    }
                }
            }
        }

        stage('2. Build & Push: client (Flutter Web)') {
            steps {
                script {
                    def imgClient = "${env.HARBOR_REGISTRY}/${env.HARBOR_PROJECT}/client:${params.IMAGE_TAG}"
                    echo "=== Compiling & Pushing Flutter Web Client Image: ${imgClient} ==="
                    sh """
                    docker build --platform linux/amd64 \
                        --build-arg BASE_HREF="${params.BASE_HREF}" \
                        --build-arg API_BASE_URL="${params.API_BASE_URL}" \
                        -t "${imgClient}" \
                        .
                    docker push "${imgClient}"
                    """
                }
            }
        }
    }

    post {
        always {
            sh 'docker logout "${HARBOR_REGISTRY}" || true'
        }
        success {
            echo "=========================================================="
            echo " [SUCCESS] client:latest built and pushed to Harbor successfully!"
            echo " Target Tag: ${params.IMAGE_TAG}"
            echo "=========================================================="
        }
        failure {
            echo "=========================================================="
            echo " [FAILURE] Client CI Pipeline failed. Check log above."
            echo "=========================================================="
        }
    }
}
