// Super App Android build: compiles the APK inside Jenkins (Flutter Docker image)
// and publishes it to Nexus apk-test-builds.
//
// Triggered by the backend (JenkinsService.triggerSuperAppBuild). Progress goes to
// /release-assembly/build-stage-update, the result to /release-assembly/build-callback,
// both with x-callback-token. Leave CALLBACK_URL empty for a dry run that reports nothing.
//
// Secrets (CALLBACK_TOKEN, NEXUS_PASSWORD) are read by the shell from the environment,
// never interpolated into the script text or a command line.
import groovy.json.JsonOutput

// Parameters added after the job was created are null on the first run with this
// file (Jenkins learns them from that run), so read them with their defaults.
def p(String name) {
    def defaults = [
        MOBILE_REPO_URL: 'https://git.fintechcenterfsa.com/frontend/super-app.git',
        MOBILE_BRANCH: 'development',
        GIT_CREDENTIALS_ID: 'git-action',
        NATIVE_SDK_MANIFEST_URL: '',
        API_BASE_URL: '',
        FLUTTER_IMAGE: 'ghcr.io/cirruslabs/flutter:3.44.0',
        TOOLCHAIN_CHECK_ONLY: false,
        PRIVATE_GIT_DEPS: '',
        BUILD_CREDENTIALS_URL: '',
        PUB_GATEWAY_URL: 'https://app.fintechcenterfsa.com/pub',
    ]
    def v = params[name]
    return (v == null || v == '') ? defaults[name] : v
}

/** Private Git dependencies of the Super App: "<https url>=<Jenkins SSH credential id>", comma separated. */
def privateGitDeps() {
    def deps = []
    for (entry in (p('PRIVATE_GIT_DEPS') ?: '').split(',')) {
        def e = entry.trim()
        if (!e) continue
        def parts = e.split('=', 2)
        if (parts.length != 2 || !(parts[0] ==~ /https:\/\/github\.com\/[A-Za-z0-9._-]+\/[A-Za-z0-9._-]+\.git/) || !(parts[1] ==~ /[A-Za-z0-9._-]+/)) {
            error("Invalid PRIVATE_GIT_DEPS entry: ${e}")
        }
        deps << [url: parts[0], cred: parts[1]]
    }
    return deps
}

/** Backend list of each in-build mini app's private repository and its key. */
def gitCredentialsUrl() {
    def explicit = (p('BUILD_CREDENTIALS_URL') ?: '').trim()
    if (explicit) return explicit
    def base = (params.CALLBACK_URL ?: '').trim()
    return base ? base.replaceAll('/build-callback/?$', '/build-git-credentials') : ''
}

/** Turns git-credentials.json into an SSH config, key files and Git insteadOf rules (no backslashes: kept in a Groovy string). */
def gitConfigJs() {
    return '''
const fs = require('fs');
const S = process.argv[2];
const NL = String.fromCharCode(10), TAB = String.fromCharCode(9);
const data = JSON.parse(fs.readFileSync(S + '/git-credentials.json', 'utf8'));
let ssh = '', git = '', n = 0;
for (const c of data.credentials || []) {
  const i = n++;
  if (c.type === 'ssh') {
    fs.writeFileSync(S + '/app_key_' + i, c.privateKey, { mode: 0o600 });
    ssh += ['Host app-dep-' + i, '  HostName ' + c.host, '  User git', '  IdentityFile ' + S + '/app_key_' + i,
            '  IdentitiesOnly yes', '  StrictHostKeyChecking accept-new', '  UserKnownHostsFile ' + S + '/known_hosts', ''].join(NL);
    git += '[url "app-dep-' + i + ':' + c.path + '"]' + NL + TAB + 'insteadOf = ' + c.repoUrl + NL;
  } else if (c.type === 'token') {
    git += '[url "https://oauth2:' + encodeURIComponent(c.token) + '@' + c.host + '/' + c.path + '"]' + NL + TAB + 'insteadOf = ' + c.repoUrl + NL;
  }
  console.log('Private repository for ' + c.appId + ': ' + c.repoUrl + ' (' + c.type + ')');
}
fs.appendFileSync(S + '/ssh_config', ssh, { mode: 0o600 });
fs.appendFileSync(S + '/gitconfig', git, { mode: 0o600 });
for (const s of data.skipped || []) console.log('WARNING: ' + s.appId + ': ' + s.reason);
console.log('Private mini app repositories: ' + n);
'''
}

/**
 * Runs body with the private Git repositories of the mini apps in this build
 * reachable: each with the deploy key or token its developer registered
 * (backend build-git-credentials), plus any extra PRIVATE_GIT_DEPS entries
 * from Jenkins credentials. Writes $WORKSPACE/.ci-secrets (SSH config, keys,
 * a Git insteadOf per repository, so other URLs stay anonymous) and always
 * removes it afterwards; nothing there is archived or uploaded.
 */
def withPrivateGitDeps(Closure body) {
    def deps = privateGitDeps()
    def bindings = []
    def list = []
    for (int i = 0; i < deps.size(); i++) {
        bindings << sshUserPrivateKey(credentialsId: deps[i].cred, keyFileVariable: "GIT_DEP_KEY_${i}")
        list << "${i}|${deps[i].url}"
    }
    sh 'S="$WORKSPACE/.ci-secrets"; rm -rf "$S"; mkdir -p "$S"; chmod 700 "$S"; : > "$S/ssh_config"; : > "$S/gitconfig"'
    try {
        def credsUrl = gitCredentialsUrl()
        if (credsUrl) {
            writeFile file: '.ci-secrets/write-git-config.js', text: gitConfigJs()
            withEnv(["GIT_CREDS_URL=${credsUrl}"]) {
                sh '''
                    set -e
                    S="$WORKSPACE/.ci-secrets"
                    code=$(curl -sS --max-time 30 -o "$S/git-credentials.json" -w '%{http_code}' \
                        -H "x-callback-token: ${CALLBACK_TOKEN:-}" "$GIT_CREDS_URL") || code=error
                    chmod 600 "$S/git-credentials.json" 2>/dev/null || true
                    if [ "$code" = "200" ]; then
                        node "$S/write-git-config.js" "$S"
                    elif [ "$code" = "404" ]; then
                        echo "WARNING: this backend has no build-git-credentials yet; private mini app repositories are not set up"
                    else
                        echo "Could not read private repository keys from $GIT_CREDS_URL (HTTP $code)"; exit 1
                    fi
                    rm -f "$S/git-credentials.json"
                '''
            }
        } else {
            echo 'WARNING: no backend URL for private repository keys (CALLBACK_URL / BUILD_CREDENTIALS_URL); only PRIVATE_GIT_DEPS is used'
        }
        if (deps) {
            withCredentials(bindings) {
                withEnv(["GIT_DEP_LIST=${list.join('\n')}"]) {
                    sh '''
                        set -e
                        S="$WORKSPACE/.ci-secrets"
                        printf '%s\\n' "$GIT_DEP_LIST" | while IFS='|' read -r i url; do
                            [ -n "$url" ] || continue
                            cp "$(printenv "GIT_DEP_KEY_$i")" "$S/jk_key_$i"; chmod 600 "$S/jk_key_$i"
                            printf 'Host jk-dep-%s\\n  HostName github.com\\n  User git\\n  IdentityFile %s\\n  IdentitiesOnly yes\\n  StrictHostKeyChecking accept-new\\n  UserKnownHostsFile %s/known_hosts\\n' "$i" "$S/jk_key_$i" "$S" >> "$S/ssh_config"
                            printf '[url "jk-dep-%s:%s"]\\n\\tinsteadOf = %s\\n' "$i" "${url#https://github.com/}" "$url" >> "$S/gitconfig"
                        done
                        echo "Extra private repositories (PRIVATE_GIT_DEPS): $(grep -c 'jk-dep-' "$S/gitconfig" || true)"
                    '''
                }
            }
        }
        body()
    } finally {
        sh 'rm -rf "$WORKSPACE/.ci-secrets"'
    }
}

def callbackBase() { return (params.CALLBACK_URL ?: '').trim() }

def validateParams() {
    if (!(params.RELEASE_VERSION ==~ /[A-Za-z0-9._-]{1,64}/)) { error("Invalid RELEASE_VERSION") }
    if (!(params.APP_NAME ==~ /[A-Za-z0-9._-]{1,64}/)) { error("Invalid APP_NAME") }
    if (!(p('MOBILE_BRANCH') ==~ /[A-Za-z0-9._\/-]{1,100}/)) { error("Invalid MOBILE_BRANCH") }
    if (!(p('MOBILE_REPO_URL') ==~ /https:\/\/[A-Za-z0-9._:\/-]+\.git/)) { error("Invalid MOBILE_REPO_URL") }
    if (!(params.NEXUS_URL ==~ /https?:\/\/[A-Za-z0-9._:\/-]+/)) { error("Invalid NEXUS_URL") }
    if (callbackBase() && !(callbackBase() ==~ /https?:\/\/[A-Za-z0-9._:\/-]+\/build-callback\/?/)) { error("Invalid CALLBACK_URL") }
    if (p('API_BASE_URL') && !(p('API_BASE_URL') ==~ /https?:\/\/[A-Za-z0-9._:\/~%-]+/)) { error("Invalid API_BASE_URL") }
    if (!(p('FLUTTER_IMAGE') ==~ /[A-Za-z0-9._\/-]+(:[A-Za-z0-9._-]+)?/)) { error("Invalid FLUTTER_IMAGE") }
}

/** POSTs JSON to the backend with the callback token; never fails the build. */
def postJson(String url, Map body) {
    if (!url) return
    writeFile file: '.callback-body.json', text: JsonOutput.toJson(body)
    withEnv(["POST_URL=${url}"]) {
        sh '''
            code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 30 -X POST "$POST_URL" \
                -H 'Content-Type: application/json' -H "x-callback-token: ${CALLBACK_TOKEN:-}" \
                --data @.callback-body.json) || code=error
            echo "Callback $(basename "$POST_URL"): HTTP $code"
            rm -f .callback-body.json
        '''
    }
}

def postStage(String stageId, String stageName, String status, String details) {
    def base = callbackBase()
    if (!base) return
    postJson(base.replaceAll('/build-callback/?$', '/build-stage-update'), [
        appName: params.APP_NAME, releaseVersion: params.RELEASE_VERSION,
        stageId: stageId, stageName: stageName, status: status, details: details,
    ])
}

/** Runs a stage body, reporting RUNNING / COMPLETED / FAILED to the backend. */
def runStage(String stageId, String stageName, String startDetails, String doneDetails, Closure body) {
    postStage(stageId, stageName, 'RUNNING', startDetails)
    try {
        body()
        postStage(stageId, stageName, 'COMPLETED', doneDetails)
    } catch (e) {
        env.FAILURE_REASON = "${stageName}: ${e.message ?: e.toString()}".take(500)
        postStage(stageId, stageName, 'FAILED', env.FAILURE_REASON)
        throw e
    }
}

def apkName() { return "superapp-test-${params.RELEASE_VERSION}.apk" }
def apkUrl() { return "${params.NEXUS_URL}/repository/apk-test-builds/${params.APP_NAME}/${params.RELEASE_VERSION}/${apkName()}" }

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        string(name: 'APP_NAME', defaultValue: 'superapp', description: 'Sub-folder in the Nexus repository')
        string(name: 'RELEASE_VERSION', defaultValue: 'v0.0.1', description: 'Super App release tag')
        choice(name: 'BUILD_TYPE', choices: ['release', 'debug'], description: 'Flutter build mode')
        string(name: 'CALLBACK_URL', defaultValue: '', description: 'Backend .../release-assembly/build-callback URL. Empty: report nothing (dry run).')
        string(name: 'CALLBACK_TOKEN', defaultValue: '', description: 'Sent as x-callback-token (passed by the backend)')
        string(name: 'NEXUS_URL', defaultValue: 'https://app.fintechcenterfsa.com/nexus', description: 'Sonatype Nexus URL')
        string(name: 'NEXUS_USER', defaultValue: 'admin', description: 'Nexus user (upload, Native SDK Maven repo)')
        password(name: 'NEXUS_PASSWORD', defaultValue: '', description: 'Nexus password (passed by the backend; no default)')
        string(name: 'API_BASE_URL', defaultValue: '', description: 'Backend URL baked into the app (--dart-define=API_BASE_URL). Empty: the app default.')
        string(name: 'MOBILE_REPO_URL', defaultValue: 'https://git.fintechcenterfsa.com/frontend/super-app.git', description: 'Super App source repository')
        string(name: 'MOBILE_BRANCH', defaultValue: 'development', description: 'Super App branch to build')
        string(name: 'GIT_CREDENTIALS_ID', defaultValue: 'git-action', description: 'Jenkins credential for MOBILE_REPO_URL')
        string(name: 'NATIVE_SDK_MANIFEST_URL', defaultValue: '', description: 'Native SDK list URL. Empty: derived from CALLBACK_URL.')
        string(name: 'FLUTTER_IMAGE', defaultValue: 'ghcr.io/cirruslabs/flutter:3.44.0', description: 'Docker image with Flutter and the Android SDK')
        string(name: 'PUB_GATEWAY_URL', defaultValue: 'https://app.fintechcenterfsa.com/pub', description: 'Pub registry the Super App pubspec.yaml uses for mini app packages; the build reads it with CALLBACK_TOKEN')
        string(name: 'PRIVATE_GIT_DEPS', defaultValue: '', description: 'Extra private Git dependencies not registered as mini apps: <https url>=<Jenkins SSH deploy-key credential id>, comma separated')
        string(name: 'BUILD_CREDENTIALS_URL', defaultValue: '', description: 'Backend build-git-credentials URL (each mini app private repository key). Empty: derived from CALLBACK_URL.')
        booleanParam(name: 'TOOLCHAIN_CHECK_ONLY', defaultValue: false, description: 'Only check the build machine (Docker, Flutter, source mount, pub get); build and upload nothing')
        string(name: 'CODEGEN_MR_IID', defaultValue: '', description: 'Unused; accepted so older backends can still trigger the job')
    }

    environment {
        MOBILE_DIR = 'mobile'
    }

    stages {
        stage('1. Pre-Flight') {
            steps {
                script {
                    validateParams()
                    echo "App ${params.APP_NAME} ${params.RELEASE_VERSION} (${params.BUILD_TYPE}) from ${p('MOBILE_REPO_URL')} @ ${p('MOBILE_BRANCH')}"
                    echo "Callbacks: ${callbackBase() ?: '(none: dry run)'}; Flutter image: ${p('FLUTTER_IMAGE')}"
                    runStage('preflight', '1. Pre-Flight & Source Checkout',
                            'Fetching the Super App source...', "Source ${p('MOBILE_BRANCH')} checked out.") {
                        dir(env.MOBILE_DIR) {
                            checkout([$class: 'GitSCM',
                                branches: [[name: "*/${p('MOBILE_BRANCH')}"]],
                                userRemoteConfigs: [[url: p('MOBILE_REPO_URL'), credentialsId: p('GIT_CREDENTIALS_ID')]],
                                extensions: [[$class: 'CloneOption', depth: 1, shallow: true, noTags: true],
                                             [$class: 'CleanBeforeCheckout']]])
                        }
                        // Packages only a developer PC can serve make the build fail later with a vague error
                        def local = sh(returnStdout: true, script: "grep -nE 'url: *https?://(localhost|127\\.0\\.0\\.1|10\\.0\\.2\\.2|host\\.docker\\.internal)' ${env.MOBILE_DIR}/pubspec.yaml || true").trim()
                        if (local && p('TOOLCHAIN_CHECK_ONLY')) {
                            echo "WARNING (toolchain check continues): developer-PC registries in pubspec.yaml:\n${local}"
                        } else if (local) {
                            error("pubspec.yaml uses a package registry on a developer PC, which this build cannot reach:\n${local}\nPublish those packages to the production Nexus and point pubspec.yaml at it.")
                        }
                    }
                }
            }
        }

        stage('2. Native SDK mini apps') {
            steps {
                script {
                    runStage('native_sdks', '2. Native SDK Mini Apps',
                            'Reading which Native SDK libraries this build includes...', 'Native SDK list ready.') {
                        def manifestUrl = p('NATIVE_SDK_MANIFEST_URL')?.trim() ?:
                                (callbackBase() ? callbackBase().replaceAll('/build-callback/?$', '/native-sdk-manifest') : '')
                        if (!manifestUrl) {
                            echo 'WARNING: no Native SDK list URL; building without Native SDK mini apps'
                            sh "rm -f ${env.MOBILE_DIR}/native_sdks.json"
                            return
                        }
                        // Never drop SDKs silently: fail when the list cannot be read
                        withEnv(["MANIFEST_URL=${manifestUrl}"]) {
                            sh '''
                                set -e
                                curl -sSf --max-time 30 -H "x-callback-token: ${CALLBACK_TOKEN:-}" "$MANIFEST_URL" -o "$MOBILE_DIR/native_sdks.json"
                                echo "Native SDK list:"; cat "$MOBILE_DIR/native_sdks.json"; echo
                            '''
                        }
                        archiveArtifacts artifacts: "${env.MOBILE_DIR}/native_sdks.json", fingerprint: true
                    }
                }
            }
        }

        stage('3. Compile APK') {
            steps {
                script {
                    runStage('compile', '3. Compile APK',
                            "Compiling the Super App ${params.BUILD_TYPE} APK (android-arm, arm64, x64)...",
                            "APK compiled.") {
                        withPrivateGitDeps {
                        withEnv(["FLUTTER_IMAGE=${p('FLUTTER_IMAGE')}", "PUB_GATEWAY_URL=${p('PUB_GATEWAY_URL')}", "API_BASE_URL=${p('API_BASE_URL') ?: ''}", "TOOLCHAIN_CHECK_ONLY=${p('TOOLCHAIN_CHECK_ONLY') ? 'true' : 'false'}"]) {
                            sh '''
                                set -e
                                S="$WORKSPACE/.ci-secrets"
                                if [ -f "$S/gitconfig" ]; then
                                    export GIT_SSH_COMMAND="ssh -F $S/ssh_config" GIT_DEPS_CONFIG="$S/gitconfig"
                                fi
                                export FSA_PUB_TOKEN="${CALLBACK_TOKEN:-}"
                                # Kept in the workspace between builds so Gradle and pub do not download everything each time
                                CACHE_DIR="$WORKSPACE/.ci-cache"
                                mkdir -p "$CACHE_DIR/pub" "$CACHE_DIR/gradle"
                                # Jenkins runs in a container that talks to the host's Docker: share its
                                # volumes so the build container sees this workspace at the same path.
                                SELF=$(cat /etc/hostname)
                                if docker inspect "$SELF" >/dev/null 2>&1; then MOUNT="--volumes-from $SELF"
                                else MOUNT="-v $WORKSPACE:$WORKSPACE"; fi

                                docker run --rm $MOUNT -w "$WORKSPACE/$MOBILE_DIR" \
                                    --memory 6g --cpus 2 \
                                    -e PUB_CACHE="$CACHE_DIR/pub" -e GRADLE_USER_HOME="$CACHE_DIR/gradle" \
                                    -e GRADLE_OPTS="-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx3g" \
                                    -e NEXUS_USER -e NEXUS_PASSWORD -e API_BASE_URL -e BUILD_TYPE -e TOOLCHAIN_CHECK_ONLY \
                                    -e GIT_SSH_COMMAND -e GIT_DEPS_CONFIG -e FSA_PUB_TOKEN -e PUB_GATEWAY_URL \
                                    -e HOST_UID="$(id -u)" -e HOST_GID="$(id -g)" \
                                    "$FLUTTER_IMAGE" bash -ec '
                                        # Files written as root inside go back to the Jenkins user
                                        trap "chown -R $HOST_UID:$HOST_GID . $PUB_CACHE $GRADLE_USER_HOME 2>/dev/null || true" EXIT
                                        git config --global --add safe.directory "*"
                                        if [ -n "${GIT_DEPS_CONFIG:-}" ]; then git config --global include.path "$GIT_DEPS_CONFIG"; fi
                                        # Mini app packages come from the /pub gateway; the build token reads them (never written to disk)
                                        if [ -n "${FSA_PUB_TOKEN:-}" ]; then dart pub token add "$PUB_GATEWAY_URL" --env-var FSA_PUB_TOKEN; fi
                                        flutter --version
                                        test -f pubspec.yaml && echo "Source visible in the build container"
                                        if [ "$TOOLCHAIN_CHECK_ONLY" = "true" ]; then
                                            flutter pub get || echo "TOOLCHAIN CHECK: pub get failed (see above)"
                                            exit 0
                                        fi
                                        flutter pub get
                                        DEFINES=""
                                        if [ -n "$API_BASE_URL" ]; then DEFINES="--dart-define=API_BASE_URL=$API_BASE_URL"; fi
                                        case "$API_BASE_URL" in http://*) DEFINES="$DEFINES --dart-define=ALLOW_CLEARTEXT=true";; esac
                                        flutter build apk --$BUILD_TYPE --target-platform android-arm,android-arm64,android-x64 $DEFINES
                                    '
                                if [ "$TOOLCHAIN_CHECK_ONLY" = "true" ]; then echo "Toolchain check done"; exit 0; fi
                                APK="$MOBILE_DIR/build/app/outputs/flutter-apk/app-$BUILD_TYPE.apk"
                                test -s "$APK" || { echo "No APK at $APK"; exit 1; }
                                ls -l "$APK"
                            '''
                        }
                        }
                    }
                }
            }
        }

        stage('4. Publish to Nexus') {
            when { expression { !p('TOOLCHAIN_CHECK_ONLY') } }
            steps {
                script {
                    runStage('publish', '4. Publish to Nexus (apk-test-builds)',
                            'Uploading the APK to Sonatype Nexus...',
                            "Published ${apkName()} to apk-test-builds/${params.APP_NAME}/${params.RELEASE_VERSION}/.") {
                        withEnv(["APK_URL=${apkUrl()}"]) {
                            sh '''
                                set -e
                                APK="$MOBILE_DIR/build/app/outputs/flutter-apk/app-$BUILD_TYPE.apk"
                                LIST_URL="${APK_URL%/*}/native_sdks.json"
                                # Credentials through a stdin config so the password never appears in `ps`
                                upload() {
                                    printf 'user = "%s:%s"\\n' "${NEXUS_USER:-admin}" "${NEXUS_PASSWORD:-}" \
                                        | curl -sSf -K - --upload-file "$1" "$2" > /dev/null
                                }
                                upload "$APK" "$APK_URL"
                                echo "Uploaded $APK_URL"
                                if [ -f "$MOBILE_DIR/native_sdks.json" ]; then upload "$MOBILE_DIR/native_sdks.json" "$LIST_URL"; echo "Uploaded $LIST_URL"; fi
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            script {
                postJson(callbackBase(), [
                    appName: params.APP_NAME, releaseVersion: params.RELEASE_VERSION, status: 'COMPLETED',
                    buildType: params.BUILD_TYPE, apkUrl: apkUrl(), filename: apkName(), repoName: 'apk-test-builds',
                ])
            }
        }
        failure {
            script {
                postJson(callbackBase(), [
                    appName: params.APP_NAME, releaseVersion: params.RELEASE_VERSION, status: 'FAILED',
                    buildType: params.BUILD_TYPE,
                    errorMessage: env.FAILURE_REASON ?: 'Super App build failed. See the Jenkins console for details.',
                ])
            }
        }
    }
}
