# =============================================================================
# Super App Backend - Environment Template (.env.example)
# =============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=development
ENVIRONMENT=DEV

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=your_secure_db_password
DB_DATABASE=dps_db
DB_SYNC=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_KEY_ID=dps-key-1
JWT_ISSUER=http://localhost:3000
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
BACK_OFFICE_ACCESS_TOKEN_TTL_SECONDS=900
BACK_OFFICE_REFRESH_TOKEN_TTL_SECONDS=604800
CREDENTIAL_ENCRYPTION_KEY=your_aes_credential_encryption_key

# Email Notifications (Resend API)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@fintechcenterfsa.com

# Telegram Bot Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_USERNAME=superapp_notification_bot

# Sonatype Nexus Registry Configuration
NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=your_secure_nexus_password
NEXUS_PUB_HOSTED_URL=http://localhost:8081/repository/pub-hosted
NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
NEXUS_NPM_SDK_REPO=npm-hosted
NEXUS_MAVEN_SDK_REPO=maven-sdk-hosted
NEXUS_COCOAPODS_SPECS_REPO=cocoapods-specs
NEXUS_RAW_SDK_REPO=raw-sdk-artifacts

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_secure_minio_password
MINIO_BUCKET_NAME=mini-app-assets
MINIO_PACKAGE_SUBMISSIONS_BUCKET=package-submissions
MINIO_SDK_SUBMISSIONS_BUCKET=sdk-submissions
MINIO_BACKOFFICE_USER_MEDIA_BUCKET=backoffice-user-media
MINIO_PUBLIC_URL=http://localhost:9000

# Jenkins CI/CD Orchestration Configuration
JENKINS_URL=http://localhost:8085
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token
CALLBACK_BASE_URL=http://host.docker.internal:3000
JENKINS_NEXUS_URL=http://host.docker.internal:8081
RELEASE_CALLBACK_TOKEN=your_release_callback_token
JENKINS_GIT_CREDENTIALS_ID=git-action
JENKINS_USE_SCM=true

# Git Repository & Codegen Providers (GitLab)
GIT_PROVIDER=gitlab
GITLAB_BASE_URL=https://git.fintechcenterfsa.com
GITLAB_TOKEN=your_gitlab_personal_access_token
GIT_REPO_TOKEN=your_git_repo_clone_token

# Backoffice Web App Integration Endpoints
BACKOFFICE_BASE_URL=http://localhost:3002
WEBAPP_URL=http://localhost:3002
AUTO_DETECT_LAN_IP=false

# Super App Mobile Repository & Sandbox Build Settings
SUPERAPP_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git
SUPERAPP_GIT_BRANCH=molika
SUPERAPP_SANDBOX_BASE_HREF=/superapp-sandbox/
SUPERAPP_SANDBOX_BUILD_MODE=release
MOBILE_API_BASE_URL=http://localhost:3000
MOBILE_VERIFY_URL_BASE=superapp://verify-email
MOBILE_ACCESS_TOKEN_TTL_SECONDS=86400
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
MOBILE_REQUIRE_EMAIL_VERIFICATION=true

# Initial Seed Administrative Accounts
SUPERADMIN_PASSWORD=your_initial_admin_password
