# =============================================================================
# Super App Backend - Environment Template (.env.example)
# =============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=development
ENVIRONMENT=DEV

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=your_secure_db_password
DB_DATABASE=dps_db
DB_SYNC=false

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_KEY_ID=dps-key-1
JWT_ISSUER=http://localhost:3000
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
BACK_OFFICE_ACCESS_TOKEN_TTL_SECONDS=900
BACK_OFFICE_REFRESH_TOKEN_TTL_SECONDS=604800
CREDENTIAL_ENCRYPTION_KEY=your_aes_credential_encryption_key

# Email Notifications (Resend API)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=notifications@fintechcenterfsa.com

# Telegram Bot Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Sonatype Nexus Registry Configuration
NEXUS_BASE_URL=http://localhost:8081
# Where the backend itself calls Nexus (optional; defaults to NEXUS_BASE_URL).
# In Kubernetes use the Service: calling the public hostname from inside the
# cluster gets connections reset ("fetch failed", ECONNRESET). Links handed to
# Jenkins and phones keep NEXUS_BASE_URL.
NEXUS_INTERNAL_URL=
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=your_secure_nexus_password
NEXUS_PUB_HOSTED_URL=http://localhost:8081/repository/pub-hosted
NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
NEXUS_NPM_SDK_REPO=npm-hosted
NEXUS_MAVEN_SDK_REPO=maven-sdk-hosted
NEXUS_COCOAPODS_SPECS_REPO=cocoapods-specs
NEXUS_RAW_SDK_REPO=raw-sdk-artifacts
SUPER_APP_PUB_URL=https://app.fintechcenterfsa.com/pub

# MinIO Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_secure_minio_password
MINIO_BUCKET_NAME=superapp-storage
MINIO_PUBLIC_URL=http://localhost:9000

# Jenkins CI/CD Orchestration Configuration
JENKINS_URL=http://localhost:8085
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token
CALLBACK_BASE_URL=http://host.docker.internal:3000
JENKINS_NEXUS_URL=http://host.docker.internal:8081
# When Jenkins cannot run a scan, the built-in (simulated) scanners stand in only
# outside production. Set true/false to override.
# LOCAL_SCANNER_FALLBACK=true
RELEASE_CALLBACK_TOKEN=your_release_callback_token
# Pub registry written into the Super App pubspec.yaml for mini app packages (the /pub gateway)
SUPER_APP_PUB_URL=https://app.fintechcenterfsa.com/pub
JENKINS_GIT_CREDENTIALS_ID=git-action
JENKINS_USE_SCM=true

# Git Repositories & SCM Providers (GitLab)
GIT_PROVIDER=gitlab
GITLAB_BASE_URL=https://git.fintechcenterfsa.com

# 1. Mobile App (Flutter SuperApp) - Git Repository, Branch & Codegen Token (Project 71)
MOBILE_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git
MOBILE_GIT_BRANCH=molika
MOBILE_GIT_TOKEN=your_mobile_gitlab_access_token

# 2. Backend Platform (NestJS) - Git Repository, Branch & CI SCM Token (Project 74)
BACKEND_GIT_REPO_URL=https://git.fintechcenterfsa.com/backend/super-app.git
BACKEND_GIT_BRANCH=molika
BACKEND_GIT_TOKEN=your_backend_git_repo_token

# Backoffice Web App Integration Endpoint (WEBAPP_URL removed as redundant)
BACKOFFICE_BASE_URL=http://localhost:3002
AUTO_DETECT_LAN_IP=false

# Super App Mobile Repository & Sandbox Build Settings
SUPERAPP_SANDBOX_BASE_HREF=/superapp-sandbox/
SUPERAPP_SANDBOX_URL=/superapp-sandbox/index.html
SUPERAPP_SANDBOX_BUILD_MODE=release
MOBILE_API_BASE_URL=http://localhost:3000
MOBILE_VERIFY_URL_BASE=superapp://verify-email
MOBILE_ACCESS_TOKEN_TTL_SECONDS=86400
MOBILE_REFRESH_TOKEN_TTL_DAYS=30
MOBILE_REQUIRE_EMAIL_VERIFICATION=true

# Initial Seed Administrative Accounts
SUPERADMIN_PASSWORD=your_initial_admin_password


# Local Super App workspace writes and builds (pubspec inject/sync, mini app registry,
# local APK and sandbox builds). These rewrite the super-app checkout from the database,
# so they are OFF unless explicitly enabled. Enable only on a developer workstation.
LOCAL_BUILDS_ENABLED=false

# Telegram webhook secret. The backend reads bot updates by polling (getUpdates), so leave
# this empty and do NOT call setWebhook (Telegram refuses getUpdates while a webhook is set).
# Empty = POST /telegram/webhook returns 404. Only set it if you switch to webhooks: pass the
# same value as secret_token to setWebhook.
TELEGRAM_WEBHOOK_SECRET=

# Signs image links served by /storage/asset (HMAC). Optional: falls back to JWT_SECRET.
# Changing it invalidates links already handed out (clients refetch them).
ASSET_URL_SECRET=
