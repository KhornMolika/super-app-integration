# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=admin
DB_PASSWORD=your_secure_db_password
DB_DATABASE=dps_db

# Default System Administrator Accounts (seeded on initial startup)
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=your_secure_superadmin_password
ADMIN_EMAIL=admin@example.com
MANAGER_EMAIL=manager@example.com
DEV_EMAIL=dev@example.com

# MinIO / AIStor Object Storage Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your_secure_minio_password
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=mini-app-assets
MINIO_PACKAGE_SUBMISSIONS_BUCKET=package-submissions
MINIO_SDK_SUBMISSIONS_BUCKET=sdk-submissions
MINIO_PUBLIC_URL=http://localhost:9000

# MinIO AIStor / Commercial License (Optional)
MINIO_AISTOR_LICENSE=
MINIO_SUBNET_LICENSE=
MINIO_LICENSE=

# Sonatype Nexus Registry Configuration
NEXUS_PORT=8081
NEXUS_BASE_URL=http://localhost:8081
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=your_secure_nexus_password
NEXUS_PUB_GROUP_URL=http://localhost:8081/repository/pub-group
NEXUS_PUB_HOSTED_URL=http://localhost:8081/repository/pub-hosted

# Jenkins Automation Configuration
JENKINS_URL=http://localhost:8085
JENKINS_USER=admin
JENKINS_API_TOKEN=your_secure_jenkins_token
CALLBACK_BASE_URL=http://localhost:3000
JENKINS_NEXUS_URL=http://host.docker.internal:8081
RELEASE_CALLBACK_TOKEN=your_secure_jenkins_callback_shared_token

# Enterprise GitLab Integration
GITLAB_BASE_URL=https://git.fintechcenterfsa.com
GITLAB_TOKEN=your_secure_gitlab_token

# Web App Backoffice URL (for email links, Telegram notifications, and sandbox redirects)
# If set to localhost or left unset, the backend automatically detects your Wi-Fi/LAN IP address
BACKOFFICE_BASE_URL=http://localhost:3002
WEBAPP_URL=http://localhost:3002
AUTO_DETECT_LAN_IP=true

# Official Super App Git & Sandbox Build Settings
SUPERAPP_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git
SUPERAPP_GIT_BRANCH=main
SUPERAPP_SANDBOX_BASE_HREF=/superapp-sandbox/
SUPERAPP_SANDBOX_BUILD_MODE=release

# Local Workspace Project Paths (for local development only; in production binaries resolve via Nexus)
MOBILE_APP_DIR=../dps_mobile_app
SANDBOX_BUILD_SCRIPT_PATH=../scripts/build-sandbox.ps1

# Subtree Push Remotes (used by package scripts)
FINTECH_BACKEND_REPO_URL=https://git.fintechcenterfsa.com/backend/super-app.git
FINTECH_FRONTEND_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app-manager.git

# JWT Authentication
JWT_SECRET=super-secret-jwt-key
JWT_EXPIRES_IN=1d
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Telegram Notification Settings
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_BOT_USERNAME=superapp_notification_bot
TELEGRAM_ENABLED=true
