# =============================================================================
# Super App Backend - Production Configuration Template (.env.production.example)
# =============================================================================

# Server & Runtime Environment
PORT=3000
NODE_ENV=production
ENVIRONMENT=PROD

# PostgreSQL Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=superapp_prod_user
DB_PASSWORD=CHANGE_ME_STRONG_PRODUCTION_PASSWORD
DB_DATABASE=superapp_production_db
DB_SYNC=false

# Authentication & Security
JWT_SECRET=CHANGE_ME_SECURE_256_BIT_RANDOM_KEY
JWT_EXPIRES_IN=7d
JWT_KEY_ID=dps-key-1
JWT_ISSUER=https://app.fintechcenterfsa.com
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
BACK_OFFICE_ACCESS_TOKEN_TTL_SECONDS=900
BACK_OFFICE_REFRESH_TOKEN_TTL_SECONDS=604800
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME_SECURE_256_BIT_RANDOM_KEY

# Email Notifications (Resend API)
RESEND_API_KEY=your_production_resend_api_key
RESEND_FROM_EMAIL=notifications@fintechcenterfsa.com

# Telegram Bot Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=your_production_telegram_bot_token
TELEGRAM_CHAT_ID=your_production_telegram_chat_id
TELEGRAM_BOT_USERNAME=superapp_notification_bot

# Sonatype Nexus Registry Configuration
NEXUS_BASE_URL=https://app.fintechcenterfsa.com/nexus
NEXUS_ADMIN_USER=admin
NEXUS_ADMIN_PASSWORD=CHANGE_ME_STRONG_NEXUS_PASSWORD
NEXUS_PUB_HOSTED_URL=https://app.fintechcenterfsa.com/nexus/repository/pub-hosted
NEXUS_PUB_GROUP_URL=https://app.fintechcenterfsa.com/nexus/repository/pub-group
NEXUS_NPM_SDK_REPO=npm-hosted
NEXUS_MAVEN_SDK_REPO=maven-sdk-hosted
NEXUS_COCOAPODS_SPECS_REPO=cocoapods-specs
NEXUS_RAW_SDK_REPO=raw-sdk-artifacts

# MinIO Object Storage Configuration
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=super-app-svc
MINIO_SECRET_KEY=CHANGE_ME_STRONG_MINIO_PASSWORD
MINIO_BUCKET_NAME=mini-app-assets
MINIO_PACKAGE_SUBMISSIONS_BUCKET=package-submissions
MINIO_SDK_SUBMISSIONS_BUCKET=sdk-submissions
MINIO_BACKOFFICE_USER_MEDIA_BUCKET=backoffice-user-media
MINIO_PUBLIC_URL=http://10.200.8.6:9000

# Jenkins CI/CD Orchestration Configuration
JENKINS_URL=https://app.fintechcenterfsa.com/jenkins
JENKINS_USER=admin
JENKINS_API_TOKEN=your_jenkins_api_token
CALLBACK_BASE_URL=https://app.fintechcenterfsa.com/api
JENKINS_NEXUS_URL=https://app.fintechcenterfsa.com/nexus
RELEASE_CALLBACK_TOKEN=CHANGE_ME_RELEASE_CALLBACK_TOKEN
JENKINS_GIT_CREDENTIALS_ID=git-action
JENKINS_USE_SCM=true

# Git Repository & Codegen Providers (GitLab)
GIT_PROVIDER=gitlab
GITLAB_BASE_URL=https://git.fintechcenterfsa.com
GITLAB_TOKEN=your_gitlab_access_token
GIT_REPO_TOKEN=your_git_repo_token

# Backoffice Web App Integration Endpoints
BACKOFFICE_BASE_URL=https://app.fintechcenterfsa.com
WEBAPP_URL=https://app.fintechcenterfsa.com
AUTO_DETECT_LAN_IP=false

# Super App Mobile Repository & Build Settings
SUPERAPP_GIT_REPO_URL=https://git.fintechcenterfsa.com/frontend/super-app.git
SUPERAPP_GIT_BRANCH=main
SUPERAPP_SANDBOX_BASE_HREF=/superapp-sandbox/
SUPERAPP_SANDBOX_BUILD_MODE=release
MOBILE_API_BASE_URL=https://app.fintechcenterfsa.com/api
MOBILE_VERIFY_URL_BASE=superapp://verify-email
MOBILE_ACCESS_TOKEN_TTL_SECONDS=3600
MOBILE_REFRESH_TOKEN_TTL_DAYS=7
MOBILE_REQUIRE_EMAIL_VERIFICATION=true

# Initial Seed Administrative Accounts
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
