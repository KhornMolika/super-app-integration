# =============================================================================
# Super App Infrastructure - Docker Compose Environment Template (.env.docker.example)
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=superapp_db
POSTGRES_PORT=5432

# --- Sonatype Nexus 3 ---
NEXUS_PORT=8081

# --- MinIO (S3 Object Storage - Community Edition) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_IMAGE=quay.io/minio/aistor/minio:RELEASE.2026-09-07T08-39-31Z
MINIO_MC_IMAGE=quay.io/minio/aistor/mc:RELEASE.2026-09-19T15-24-59Z

# Signs image links served by /storage/asset (HMAC). Optional: falls back to JWT_SECRET.
# Changing it invalidates links already handed out (clients refetch them).
ASSET_URL_SECRET=

# Local Super App workspace writes and builds (pubspec inject/sync, mini app registry,
# local APK and sandbox builds). These rewrite the super-app checkout from the database,
# so they are OFF unless explicitly enabled. Enable only on a developer workstation.
LOCAL_BUILDS_ENABLED=false

# Telegram webhook secret. The backend reads bot updates by polling (getUpdates), so leave
# this empty and do NOT call setWebhook (Telegram refuses getUpdates while a webhook is set).
# Empty = POST /telegram/webhook returns 404. Only set it if you switch to webhooks: pass the
# same value as secret_token to setWebhook.
TELEGRAM_WEBHOOK_SECRET=

