# =============================================================================
# Super App Infrastructure - Docker Compose Environment Template (.env.docker.example)
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=superapp_db
POSTGRES_PORT=5432

# --- Sonatype Nexus 3 ---
NEXUS_PORT=8081

# --- MinIO (S3 / AIStor Object Storage) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_IMAGE=quay.io/minio/aistor/minio:RELEASE.2026-09-07T08-39-31Z
MINIO_SUBNET_LICENSE=
